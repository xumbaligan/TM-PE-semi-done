@page
@model TM_PE.Pages.Account.IndexModel
@{
    ViewData["Title"] = "My Account";
    Layout = Model.LayoutName;
    var emp = Model.Account.Employee;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-person-circle"></i> My Account</h2>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card p-4 mb-4">
            <h5 class="mb-3">Account</h5>
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="text-muted small">Username</div>
                    <div class="fw-semibold"><code>@Model.Account.Username</code></div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted small">Status</div>
                    <div>
                        @if (Model.Account.IsActive)
                        {
                            <span class="badge bg-success-subtle text-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-warning-subtle text-warning-emphasis">Disabled</span>
                        }
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted small">Account Created</div>
                    <div class="fw-semibold">@Model.Account.DateCreated.ToString("MMMM d, yyyy")</div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted small">Last Login</div>
                    <div class="fw-semibold">@(Model.Account.LastLogin.HasValue ? Model.Account.LastLogin.Value.ToString("MMMM d, yyyy h:mm tt") : "Never")</div>
                </div>
            </div>
        </div>

        <div class="card p-4">
            <h5 class="mb-3">Employee Information</h5>
            @if (emp == null)
            {
                <div class="text-muted">Employee record not found.</div>
            }
            else
            {
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="text-muted small">Full Name</div>
                        <div class="fw-semibold">@emp.FullName</div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted small">Email</div>
                        <div class="fw-semibold">@emp.Email</div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted small">Role</div>
                        <div><span class="badge bg-primary-subtle text-primary-emphasis">@emp.RoleType</span></div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted small">Department</div>
                        <div class="fw-semibold">@(emp.Department?.DepartmentName ?? "—")</div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted small">Hired At</div>
                        <div class="fw-semibold">@emp.HiredAt.ToString("MMMM d, yyyy")</div>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card p-4">
            <h5 class="mb-3"><i class="bi bi-key"></i> Change Password</h5>
            @if (!string.IsNullOrEmpty(Model.Message))
            {
                <div class="alert alert-success py-2 small">@Model.Message</div>
            }
            @if (!string.IsNullOrEmpty(Model.Error))
            {
                <div class="alert alert-danger py-2 small">@Model.Error</div>
            }
            <form method="post" asp-page-handler="ChangePassword">
                <div class="mb-2">
                    <label class="form-label">Current Password</label>
                    <input class="form-control" type="password" asp-for="CurrentPassword" maxlength="10" autocomplete="current-password" />
                </div>
                <div class="mb-2">
                    <label class="form-label">New Password</label>
                    <input class="form-control" type="password" asp-for="NewPassword" maxlength="10" inputmode="numeric" pattern="\d{8,10}" autocomplete="new-password" />
                    <div class="form-text">8-10 digits, numbers only.</div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Confirm New Password</label>
                    <input class="form-control" type="password" asp-for="ConfirmNewPassword" maxlength="10" inputmode="numeric" pattern="\d{8,10}" autocomplete="new-password" />
                </div>
                <button class="btn btn-primary btn-sm">Change Password</button>
            </form>
        </div>
    </div>
</div>
