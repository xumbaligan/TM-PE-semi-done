@page
@model TM_PE.Pages.VerifyCodeModel
@{
    ViewData["Title"] = "Verify Code";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify Code - Pakonek Performance</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --login-navy-deep: #00001e;
            --login-navy: #020236;
            --login-purple: #8958eb;
            --login-purple-light: #915df6;
            --login-plum-mid: #31055d;
            --login-plum: #47076f;
        }

        .login-body {
            background-color: #f1f5f9;
        }

        .login-shell {
            width: 100%;
            max-width: 1000px;
            border-radius: 28px;
            overflow: hidden;
            box-shadow: 0 10px 40px rgba(0,0,0,.18);
            background: #fff;
        }

        .login-panel-dark {
            background: linear-gradient(180deg, var(--login-navy-deep), var(--login-navy));
            color: #fff;
            padding: 2.5rem 1.5rem;
        }

        .login-logo-orb {
            width: 160px;
            max-width: 60%;
        }

        .login-wordmark {
            width: 260px;
            max-width: 80%;
        }

        .login-tagline {
            color: var(--login-purple-light);
            text-shadow: 0px 4px 4px rgba(85,50,105,.6);
            letter-spacing: .3em;
            font-size: .7rem;
            font-weight: 600;
        }

        .login-panel-light {
            padding: 2.5rem 2rem;
        }

        .login-heading .text-accent {
            color: var(--login-purple);
        }

        .login-input-group {
            display: flex;
            align-items: center;
            gap: .6rem;
            border: 1.5px solid rgba(2,2,54,.14);
            border-radius: 9px;
            box-shadow: 0 4px 5px rgba(0,0,0,.1);
            padding: .65rem .9rem;
            background: #fff;
        }

            .login-input-group i {
                color: #ccc6c6;
                font-size: 1.1rem;
            }

            .login-input-group input {
                border: 0;
                outline: 0;
                flex: 1;
                min-width: 0;
                font-size: .95rem;
            }

        .login-forgot {
            color: var(--login-purple);
            font-weight: 700;
            font-size: .8rem;
        }

        .login-btn {
            background: linear-gradient(90deg, var(--login-navy), var(--login-plum-mid), var(--login-plum));
            color: #fff;
            border: 0;
            border-radius: 9px;
            font-weight: 800;
            letter-spacing: .03em;
            padding: .85rem;
            box-shadow: 0 4px 5px rgba(0,0,0,.1);
        }

            .login-btn:hover {
                filter: brightness(1.08);
                color: #fff;
            }

        .code-input {
            letter-spacing: .6em;
            font-weight: 800;
            font-size: 1.1rem;
            text-align: center;
        }

        .resend-btn {
            background: none;
            border: 0;
            padding: 0;
        }

        @@media (max-width: 767.98px) {
            .login-panel-dark {
                padding: 1.75rem 1rem;
            }
        }
    </style>
</head>
<body class="login-body d-flex align-items-center justify-content-center min-vh-100 py-4">
    <div class="login-shell d-flex flex-column flex-md-row">
        <div class="login-panel-dark col-md-5 d-flex flex-column align-items-center justify-content-center text-center">
            <img src="~/images/login/orb.png" alt="" class="login-logo-orb mb-2" />
            <img src="~/images/login/pakonek-wordmark.png" alt="Pakonek" class="login-wordmark mb-2" />
            <div class="login-tagline">
                EMPLOYEE PERFORMANCE<br />
                TRACKING SYSTEM
            </div>
        </div>
        <div class="login-panel-light col-md-7">
            <h2 class="login-heading fw-bold mb-1">
                VERIFY <span class="text-accent">CODE</span>
            </h2>
            <p class="fw-semibold mb-1">We sent a 4-digit code to</p>
            <p class="fw-bold mb-4">@Model.MaskedEmail</p>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger py-2 small">@Model.ErrorMessage</div>
            }
            @if (!string.IsNullOrEmpty(Model.StatusMessage))
            {
                <div class="alert alert-success py-2 small">@Model.StatusMessage</div>
            }
            @if (!string.IsNullOrEmpty(Model.DevCode))
            {
                <div class="alert alert-warning py-2 small">
                    Email delivery isn't configured yet, so here's your code for testing: <strong>@Model.DevCode</strong>
                </div>
            }

            <form method="post">
                <div class="mb-4">
                    <label class="form-label fw-bold">Verification Code</label>
                    <div class="login-input-group">
                        <i class="bi bi-shield-lock-fill"></i>
                        <input type="text" asp-for="Code" class="code-input" maxlength="4" inputmode="numeric"
                               pattern="\d{4}" autofocus placeholder="0000" autocomplete="one-time-code" />
                    </div>
                </div>
                <button type="submit" class="login-btn w-100 mb-3">VERIFY</button>
            </form>

            <form method="post" asp-page-handler="Resend" class="text-center mb-2">
                <button type="submit" class="resend-btn login-forgot">Resend code</button>
            </form>

            <div class="text-center">
                <a asp-page="/ForgotPassword" class="login-forgot text-decoration-none"><i class="bi bi-arrow-left"></i> Use a different email</a>
            </div>
        </div>
    </div>

    <script>
        document.getElementById('Code').addEventListener('input', function () {
            this.value = this.value.replace(/[^0-9]/g, '');
        });
    </script>
</body>
</html>
