<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pakonek Performance</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="mobile-topbar">
        <button type="button" class="sidebar-toggle-btn" data-sidebar-toggle aria-label="Toggle menu">
            <i class="bi bi-list"></i>
        </button>
        <span class="fw-semibold"><i class="bi bi-graph-up-arrow"></i> Pakonek</span>
    </div>
    <button type="button" class="sidebar-backdrop" aria-label="Close menu" tabindex="-1"></button>
    <div class="d-flex">
        @{
            string currentPath = Context.Request.Path.Value ?? "/";
            bool IsActive(string path) => path == "/"
                ? (currentPath == "/" || currentPath.Equals("/Index", StringComparison.OrdinalIgnoreCase))
                : currentPath.StartsWith(path, StringComparison.OrdinalIgnoreCase);
            string employeeName = Context.Session.GetString("AuthEmployeeName") ?? "";
            string roleType = Context.Session.GetString("AuthRoleType") ?? "";
            string initials = string.Join("", employeeName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(n => char.ToUpper(n[0])));
        }
        <aside class="sidebar text-white p-3 d-flex flex-column">
            <div class="d-flex align-items-center gap-2 mb-4">
                <div class="sidebar-logo-badge"><i class="bi bi-graph-up-arrow"></i></div>
                <div>
                    <div class="sidebar-brand">Pakonek Solutions</div>
                    <div class="sidebar-brand-sub">Performance Tracking</div>
                </div>
            </div>

            <div class="nav-section-label">Overview</div>
            <nav class="nav flex-column">
                <a class="nav-link text-white @(IsActive("/") ? "active" : "")" asp-page="/Index"><i class="bi bi-speedometer2"></i> Dashboard</a>
            </nav>

            <div class="nav-section-label">Performance</div>
            <nav class="nav flex-column">
                <a class="nav-link text-white @(IsActive("/Manager/PerformanceReport") ? "active" : "")" asp-page="/Manager/PerformanceReport/Index"><i class="bi bi-file-earmark-text"></i> Performance Reports</a>
            </nav>

            <div class="nav-section-label">Administration</div>
            <nav class="nav flex-column">
                <a class="nav-link text-white @(IsActive("/Admin/Employees") ? "active" : "")" asp-page="/Admin/Employees/Index"><i class="bi bi-people"></i> Employees</a>
                <a class="nav-link text-white @(IsActive("/Admin/UserManagement") ? "active" : "")" asp-page="/Admin/UserManagement/Index"><i class="bi bi-person-badge"></i> Users</a>
                <a class="nav-link text-white @(IsActive("/Admin/Departments") ? "active" : "")" asp-page="/Admin/Departments/Index"><i class="bi bi-building"></i> Departments</a>
                <a class="nav-link text-white @(IsActive("/Admin/Criteria") ? "active" : "")" asp-page="/Admin/Criteria/Index"><i class="bi bi-list-check"></i> Criteria</a>
            </nav>

            <div class="mt-auto pt-3">
                <hr class="sidebar-divider" />
                @if (!string.IsNullOrEmpty(employeeName))
                {
                    <div class="sidebar-profile-card d-flex align-items-center gap-2 mb-2">
                        <div class="sidebar-avatar">@(string.IsNullOrEmpty(initials) ? "" : initials)</div>
                        <div class="flex-grow-1 overflow-hidden">
                            <div class="sidebar-profile-name text-truncate">@employeeName.ToUpper()</div>
                            <div class="sidebar-profile-role">@roleType.ToUpper()</div>
                        </div>
                    </div>
                }
                <nav class="nav flex-column">
                    <a class="sidebar-logout-link" asp-page="/Logout"><i class="bi bi-box-arrow-right"></i> LOG OUT</a>
                </nav>
            </div>
        </aside>
        <main class="flex-grow-1 p-3 p-md-4 bg-light min-vh-100" style="min-width:0;">
            <div class="app-topbar">
                <partial name="_NotificationBell" />
            </div>
            @RenderBody()
        </main>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/sidebar-toggle.js"></script>
    <script src="~/js/table-pagination.js" asp-append-version="true"></script>
    <script src="~/js/notifications.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
