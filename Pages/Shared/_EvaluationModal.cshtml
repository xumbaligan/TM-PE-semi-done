@*
    Shared "view full evaluation" modal. Any button with class
    .view-evaluation-btn and the matching data-* attributes opens it - see
    wwwroot/js/evaluation-modal.js. Used by Performance Evaluation > Index and
    by Feedback & Appraisal Records > Details so both show an evaluation in
    exactly the same shape.
*@
<div class="modal fade" id="evaluationModal" tabindex="-1" aria-labelledby="evaluationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content vm-content">

            <div class="modal-header vm-header">
                <div class="vm-header-icon"><i class="bi bi-clipboard-data"></i></div>
                <div class="flex-grow-1 overflow-hidden">
                    <div class="vm-title" id="evaluationModalLabel">Evaluation &amp; Appraisal Details</div>
                    <div class="vm-subtitle">Full evaluation record</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <hr class="vm-header-rule" />

            <div class="modal-body vm-body">

                <div class="vm-card mb-3">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                        <div>
                            <div class="vm-value fs-5" id="evalEmployee"></div>
                            <div class="vm-label" id="evalRole"></div>
                        </div>
                        <div class="text-end">
                            <div class="d-flex align-items-center gap-2 justify-content-end">
                                <span id="evalStarsTop"></span>
                                <span class="vm-value fs-5" id="evalScore"></span>
                            </div>
                            <div class="mt-1"><span class="vm-status" id="evalRatingBadge"></span></div>
                        </div>
                    </div>
                </div>

                <div class="vm-card mb-3">
                    <div class="row g-3">
                        <div class="col-6 col-md-3">
                            <div class="vm-label">Evaluation Period</div>
                            <div class="vm-value" id="evalPeriod"></div>
                        </div>
                        <div class="col-6 col-md-3 vm-col-divider">
                            <div class="vm-label">Evaluation Date</div>
                            <div class="vm-value" id="evalDate"></div>
                        </div>
                        <div class="col-6 col-md-3 vm-col-divider">
                            <div class="vm-label">Evaluated By</div>
                            <div class="vm-value" id="evalEvaluator"></div>
                        </div>
                        <div class="col-6 col-md-3 vm-col-divider">
                            <div class="vm-label">Status</div>
                            <div><span class="vm-status" id="evalStatusBadge"></span></div>
                        </div>
                    </div>
                </div>

                <div class="vm-card-label mb-2">Performance Snapshot</div>
                <div class="row g-3 mb-3">
                    <div class="col-6 col-lg-3">
                        <div class="eval-stat eval-stat-primary d-flex align-items-start gap-2">
                            <div class="stat-icon icon-palette-primary"><i class="bi bi-check2-circle"></i></div>
                            <div class="overflow-hidden">
                                <div class="stat-label">Completed Job/Task</div>
                                <div class="stat-value" id="evalStatCompleted">—</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="eval-stat eval-stat-success d-flex align-items-start gap-2">
                            <div class="stat-icon icon-palette-success"><i class="bi bi-clock-history"></i></div>
                            <div class="overflow-hidden">
                                <div class="stat-label">On-time Rate</div>
                                <div class="stat-value" id="evalStatOnTime">—</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="eval-stat eval-stat-warning d-flex align-items-start gap-2" id="evalStatTile3">
                            <div class="stat-icon icon-palette-warning" id="evalStatTile3Icon"><i class="bi bi-arrow-repeat"></i></div>
                            <div class="overflow-hidden">
                                <div class="stat-label" id="evalStatTile3Label">Rescheduled</div>
                                <div class="stat-value" id="evalStatTile3Value">—</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="eval-stat eval-stat-danger d-flex align-items-start gap-2" id="evalStatTile4">
                            <div class="stat-icon icon-palette-danger" id="evalStatTile4Icon"><i class="bi bi-x-circle"></i></div>
                            <div class="overflow-hidden">
                                <div class="stat-label" id="evalStatTile4Label">Cancelled</div>
                                <div class="stat-value" id="evalStatTile4Value">—</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="vm-card mb-3">
                    <div class="vm-card-label mb-2">Criteria Ratings</div>
                    <div class="table-responsive">
                        <table class="table vm-table align-middle">
                            <thead>
                                <tr>
                                    <th style="width:32%">Criteria</th>
                                    <th style="width:26%">Rating</th>
                                    <th style="width:14%">Score</th>
                                    <th>Feedback</th>
                                </tr>
                            </thead>
                            <tbody id="evalResultsBody"></tbody>
                        </table>
                    </div>
                </div>

                <div class="vm-card">
                    <div class="vm-card-label mb-2">Feedback</div>
                    <div class="vm-text" id="evalFeedback"></div>
                </div>

            </div>
            <div class="modal-footer vm-footer">
                <button type="button" class="vm-btn-close" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
