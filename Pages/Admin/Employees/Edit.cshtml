@page "{id:int}"
@model TM_PE.Pages.Admin.Employees.EditModel
@{
    ViewData["Title"] = "Edit Employee";
    Layout = "_Admin";
}

<div class="tf-form-page">
    <div class="tf-form-card">

        <div class="tf-form-heading">Edit Employee</div>

        <form method="post">
            <input type="hidden" asp-for="Employee.EmployeeId" />

            <div class="row g-3 align-items-end mb-3">
                <div class="col-md-8">
                    <label class="tf-label" for="Employee_FullName">
                        Full Name <span class="tf-required">*</span>
                    </label>
                    <input class="form-control" asp-for="Employee.FullName" placeholder="e.g. Juan Dela Cruz" />
                    <span asp-validation-for="Employee.FullName" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <div class="d-flex align-items-center gap-2 pb-2">
                        <input class="form-check-input tf-check-input" asp-for="Employee.IsActive" />
                        <label class="tf-check-label mb-0" for="Employee_IsActive">Active</label>
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label class="tf-label" for="Employee_Email">
                    Email <span class="tf-required">*</span>
                </label>
                <input class="form-control" asp-for="Employee.Email" placeholder="e.g. delacruz@@gmail.com" />
                <span asp-validation-for="Employee.Email" class="text-danger small"></span>
            </div>

            @* <div class="col-md-6"><label class="form-label">Position</label>
            <input class="form-control" asp-for="Employee.Position" /></div> *@

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="tf-label" for="employeeRoleDropdownBtn">
                        Role Type <span class="tf-required">*</span>
                    </label>
                    @{
                        var employeeRoleOptions = new[] {
                            ("OfficeStaff", "Office Staff"),
                            ("FieldTechnician", "Field Technician"),
                            ("Manager", "Manager"),
                            ("Admin", "Admin")
                        };
                        var currentEmployeeRoleLabel = employeeRoleOptions.FirstOrDefault(r => r.Item1 == Model.Employee.RoleType.ToString()).Item2 ?? "Select role type";
                    }
                    <div class="dropdown">
                        <button type="button" class="btn status-dropdown-btn dropdown-toggle w-100" id="employeeRoleDropdownBtn"
                                data-bs-toggle="dropdown" aria-expanded="false">
                            @currentEmployeeRoleLabel
                        </button>
                        <ul class="dropdown-menu status-dropdown-menu w-100" aria-labelledby="employeeRoleDropdownBtn">
                            @foreach (var r in employeeRoleOptions)
                            {
                                <li><a class="dropdown-item @(Model.Employee.RoleType.ToString() == r.Item1 ? "active" : "")" href="#" data-value="@r.Item1">@r.Item2</a></li>
                            }
                        </ul>
                    </div>
                    <input type="hidden" asp-for="Employee.RoleType" id="Employee_RoleType" />
                </div>

                <div class="col-md-6">
                    <label class="tf-label" for="employeeDepartmentDropdownBtn">Department</label>
                    @{
                        var selectedDepartment = Model.AllDepartments.FirstOrDefault(d => d.DepartmentId == Model.Employee.DepartmentId);
                    }
                    <div class="dropdown">
                        <button type="button" class="btn status-dropdown-btn dropdown-toggle w-100 text-start" id="employeeDepartmentDropdownBtn"
                                data-bs-toggle="dropdown" aria-expanded="false">
                            @(selectedDepartment != null ? selectedDepartment.DepartmentName : "-- Select department --")
                        </button>
                        <ul class="dropdown-menu status-dropdown-menu w-100" id="employeeDepartmentDropdownMenu" aria-labelledby="employeeDepartmentDropdownBtn">
                            <li><a class="dropdown-item @(selectedDepartment == null ? "active" : "")" href="#" data-value="">-- Select department --</a></li>
                            @foreach (var d in Model.AllDepartments)
                            {
                                <li><a class="dropdown-item @(selectedDepartment?.DepartmentId == d.DepartmentId ? "active" : "")" href="#" data-value="@d.DepartmentId" data-roletype="@d.RoleType">@d.DepartmentName</a></li>
                            }
                        </ul>
                    </div>
                    <input type="hidden" name="Employee.DepartmentId" id="Employee_DepartmentId"
                           value="@(Model.Employee.DepartmentId == 0 ? "" : Model.Employee.DepartmentId.ToString())" />
                    <div class="tf-form-hint">Only departments matching the selected role type are shown.</div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a class="tf-btn-cancel" asp-page="Index">Cancel</a>
                <button type="submit" class="tf-btn-save">Save Changes</button>
            </div>

        </form>
    </div>
</div>

<script src="~/js/status-dropdown.js"></script>
<script>
    // Letters only (e.g. Full Name)
    document.getElementById('Employee_FullName').addEventListener('keypress', function (e)
    {
        const char = String.fromCharCode(e.which);
        const lettersOnly = /^[a-zA-Z\s]$/;
        if (!lettersOnly.test(char)) {
            e.preventDefault(); // blocks the keypress
            showWarning(this, 'Letters only! No numbers or symbols allowed.');
        }
    });

    // Only show departments whose Role Type matches the selected Role Type
    (function () {
        const roleSelect = document.getElementById('Employee_RoleType');
        const deptSelect = document.getElementById('Employee_DepartmentId');
        const deptMenu = document.getElementById('employeeDepartmentDropdownMenu');
        const deptItems = Array.from(deptMenu.querySelectorAll('.dropdown-item[data-roletype]'));

        function filterDepartments() {
            const selectedRole = roleSelect.value;
            let selectedStillValid = false;

            deptItems.forEach(function (item) {
                const matches = item.dataset.roletype === selectedRole;
                item.closest('li').hidden = !matches;
                if (matches && item.dataset.value === deptSelect.value) selectedStillValid = true;
            });

            if (!selectedStillValid) {
                const firstMatch = deptItems.find(o => o.dataset.roletype === selectedRole);
                deptDropdown.selectByValue(firstMatch ? firstMatch.dataset.value : '', false);
            }
        }

        wireStatusDropdown('employeeRoleDropdownBtn', roleSelect, { onChange: filterDepartments });
        const deptDropdown = wireStatusDropdown('employeeDepartmentDropdownBtn', deptSelect);
        filterDepartments();
    })();
</script>