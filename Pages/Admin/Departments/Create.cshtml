@page
@model TM_PE.Pages.Admin.Departments.CreateModel
@{
    ViewData["Title"] = "New Department";
    Layout = "_Admin";
}

<h2 class="mb-4">New Department</h2>
<div class="card p-4" style="max-width:600px">
    <form method="post">
        <div class="mb-3">
            <label class="form-label">Name</label>
            <input class="form-control" asp-for="Department.DepartmentName" />
            <span class="text-danger" asp-validation-for="Department.DepartmentName"></span>
        </div>
        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea class="form-control" asp-for="Department.Description"></textarea>
        </div>
        <div class="mb-3">
            <label class="form-label">Role Type</label>
            <select class="form-select" asp-for="Department.RoleType">
                <option value="OfficeStaff">Office Staff</option>
                <option value="FieldTechnician">Field Technician</option>
                <option value="Manager">Manager</option>
                <option value="Admin">Admin</option>
            </select>
            <span class="text-danger" asp-validation-for="Department.RoleType"></span>
        </div>
        <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" asp-for="Department.IsActive" />
            <label class="form-check-label">Active</label>
        </div>
        <button class="btn btn-primary"><i class="bi bi-save"></i> Save</button>
        <a class="btn btn-secondary" asp-page="Index">Cancel</a>
    </form>
</div>
