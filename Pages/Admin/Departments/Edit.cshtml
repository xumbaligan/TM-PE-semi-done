@page "{id:int}"
@model TM_PE.Pages.Admin.Departments.EditModel
@{
    ViewData["Title"] = "Edit Department";
    Layout = "_Admin";
}

<div class="tf-form-page">
    <div class="tf-form-card">

        <div class="tf-form-heading">Edit Department</div>

        <form method="post">
            <input type="hidden" asp-for="Department.DepartmentId" />

            <div class="row g-3 align-items-end mb-3">
                <div class="col-md-8">
                    <label class="tf-label" asp-for="Department.DepartmentName">
                        Name <span class="tf-required">*</span>
                    </label>
                    <input class="form-control" asp-for="Department.DepartmentName" placeholder="e.g. Field Operations" />
                    <span class="text-danger small" asp-validation-for="Department.DepartmentName"></span>
                </div>

                <div class="col-md-4">
                    <div class="d-flex align-items-center gap-2 pb-2">
                        <input class="form-check-input tf-check-input" type="checkbox" asp-for="Department.IsActive" />
                        <label class="tf-check-label mb-0" asp-for="Department.IsActive">Active</label>
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label class="tf-label" asp-for="Department.Description">Description</label>
                <textarea class="form-control" asp-for="Department.Description" rows="2"
                          placeholder="Enter a description"></textarea>
            </div>

            <div class="mb-3">
                <label class="tf-label" for="roleTypeDropdownBtn">
                    Role Type <span class="tf-required">*</span>
                </label>
                @{
                    var roleTypeOptions = new[] {
                        ("OfficeStaff", "Office Staff"),
                        ("FieldTechnician", "Field Technician"),
                        ("Manager", "Manager"),
                        ("Admin", "Admin")
                    };
                    var currentRoleLabel = roleTypeOptions.FirstOrDefault(r => r.Item1 == Model.Department.RoleType.ToString()).Item2 ?? "Select role type";
                }
                <div class="dropdown">
                    <button type="button" class="btn status-dropdown-btn dropdown-toggle w-100" id="roleTypeDropdownBtn"
                            data-bs-toggle="dropdown" aria-expanded="false">
                        @currentRoleLabel
                    </button>
                    <ul class="dropdown-menu status-dropdown-menu w-100" aria-labelledby="roleTypeDropdownBtn">
                        @foreach (var r in roleTypeOptions)
                        {
                            <li><a class="dropdown-item @(Model.Department.RoleType.ToString() == r.Item1 ? "active" : "")" href="#" data-value="@r.Item1">@r.Item2</a></li>
                        }
                    </ul>
                </div>
                <input type="hidden" asp-for="Department.RoleType" id="roleTypeSelect" />
                <span class="text-danger small" asp-validation-for="Department.RoleType"></span>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a class="tf-btn-cancel" asp-page="Index">Cancel</a>
                <button type="submit" class="tf-btn-save">Save Changes</button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/status-dropdown.js"></script>
    <script>
        wireStatusDropdown('roleTypeDropdownBtn', document.getElementById('roleTypeSelect'));
    </script>
}
