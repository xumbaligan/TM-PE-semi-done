@page "{id:int}"
@model TM_PE.Pages.Admin.Criteria.EditModel
@{
    ViewData["Title"] = "Edit Criteria";
    Layout = "_Admin";
}

<h2 class="mb-4">Edit Criteria</h2>
<div class="card p-4" style="max-width:700px">
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="Item.CriteriaId" />
        <div class="mb-3">
            <label class="form-label">Criteria Name</label>
            <input class="form-control" asp-for="Item.CriteriaName" />
        </div>
        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea class="form-control" asp-for="Item.Description"></textarea>
        </div>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Role Type</label>
                <select class="form-select" asp-for="Item.RoleType" id="roleTypeSelect">
                    <option value="OfficeStaff">Office Staff</option>
                    <option value="FieldTechnician">Field Technician</option>
                </select>
            </div>
            @* <div class="col-md-6"><label class="form-label">Max Score</label>
            <input class="form-control" type="number" min="1" max="10" asp-for="Item.MaxScore" /></div> *@
            <div class="col-md-6">
                <label class="form-label">Weight (%)</label>
                <input class="form-control" type="number" step="0.5" min="0.5" max="100" asp-for="Item.Weight" />
                <span asp-validation-for="Item.Weight" class="text-danger"></span>
                <div class="form-text">
                    How much this criterion counts toward the Overall Score in a Performance Evaluation.
                    Weights for the same Role Type should add up to 100.
                </div>
                <div class="form-text fw-semibold" id="weightAvailableText"></div>
            </div>
        </div>
        <div class="form-check mt-3 mb-3">
            <input class="form-check-input" type="checkbox" asp-for="Item.IsActive" />
            <label class="form-check-label">Active</label>
        </div>
        <button class="btn btn-primary">Update</button>
        <a class="btn btn-secondary" asp-page="Index">Cancel</a>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            const roleSelect = document.getElementById('roleTypeSelect');

            // Weight already committed to other active criteria of each Role
            // Type (excluding this one), so the remaining-percent indicator
            // below can update as the manager edits Role Type / Weight,
            // mirroring what CriteriaValidation will check on Save.
            const weightUsedByRole = {
                OfficeStaff: @Model.OfficeStaffWeightUsed.ToString(System.Globalization.CultureInfo.InvariantCulture),
                FieldTechnician: @Model.FieldTechnicianWeightUsed.ToString(System.Globalization.CultureInfo.InvariantCulture)
            };
            const weightInput = document.getElementById('Item_Weight');
            const weightAvailableText = document.getElementById('weightAvailableText');

            function fmt(n) {
                return Number(n.toFixed(2)).toString();
            }

            function updateWeightAvailability() {
                const roleLabel = roleSelect.value === 'FieldTechnician' ? 'Field Technician' : 'Office Staff';
                const used = weightUsedByRole[roleSelect.value] || 0;
                const available = Math.max(0, 100 - used);
                const entered = parseFloat(weightInput.value) || 0;
                const remaining = available - entered;

                weightAvailableText.textContent = 'Other active ' + roleLabel + ' criteria are using ' + fmt(used) +
                    '% of 100% - ' + fmt(available) + '% available' +
                    (entered > 0 ? ' (' + fmt(remaining) + '% left if saved)' : '') + '.';
                weightAvailableText.classList.toggle('text-danger', remaining < 0);
                weightAvailableText.classList.toggle('text-muted', remaining >= 0);
            }

            roleSelect.addEventListener('change', updateWeightAvailability);
            weightInput.addEventListener('input', updateWeightAvailability);
            updateWeightAvailability();
        })();
    </script>
}
