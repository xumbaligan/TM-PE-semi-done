@page
@model TM_PE.Pages.Admin.Criteria.IndexModel
@{
    ViewData["Title"] = "Criteria";
    Layout = "_Admin";
}

<div class="mb-3">
    <h1 class="tf-page-title mb-1">Performance Criteria</h1>
    <p class="tf-page-sub mb-0">Evaluation weighting and requirements by role.</p>
</div>
<hr class="page-divider" />

<form method="get" class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <div class="search-input-group flex-grow-1" style="max-width:400px;">
        <i class="bi bi-search"></i>
        <input name="search" id="liveSearch" value="@Model.Search" placeholder="Search criteria..." />
    </div>
    <input type="hidden" id="liveRole" value="" />
    <div class="role-filter" id="roleFilter">
        <button type="button" class="role-filter-btn active" data-value="">All Roles</button>
        <button type="button" class="role-filter-btn" data-value="officestaff">Office Staff</button>
        <button type="button" class="role-filter-btn" data-value="fieldtechnician">Field Technician</button>
    </div>
    <a class="btn btn-navy ms-auto" asp-page="Create"><i class="bi bi-plus-lg"></i> New Criteria</a>
</form>

<div class="table-responsive wlm-card">
    <table class="table align-middle table-hover wlm-table wlm-table-fixed wlm-table-row-lg mb-0">
        <thead>
            <tr>
                <th style="width:18%">Criteria</th>
                <th style="width:18%">Description</th>
                <th style="width:18%">Role Type</th>
                <th style="width:18%">Weight</th>
                <th style="width:18%">Status</th>
                <th class="text-end" style="width:10%">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Items.Any())
            {
                <tr id="emptyRow">
                    <td colspan="6" class="text-center text-muted py-4">No criteria defined</td>
                </tr>
            }
            else
            {
                <tr id="emptyRow" style="display:none;">
                    <td colspan="6" class="text-center text-muted py-4">No criteria defined</td>
                </tr>
            }

            @foreach (var c in Model.Items)
            {
                <tr data-name="@c.CriteriaName.ToLower()"
                    data-description="@(c.Description?.ToLower() ?? "")"
                    data-role="@c.RoleType.ToString().ToLower()">
                    <td><strong>@c.CriteriaName</strong></td>
                    <td><span class="text-muted small">@c.Description</span></td>
                    <td>
                        <span class="badge rounded-pill @(c.RoleType == TM_PE.Model.RoleType.OfficeStaff ? "role-badge-office-staff" : "role-badge-field-technician")">
                            @(c.RoleType == TM_PE.Model.RoleType.OfficeStaff ? "Office Staff" : "Field Technician")
                        </span>
                    </td>
                    <td><span class="weight-text">@c.Weight.ToString("0.##")%</span></td>
                    <td>
                        @if (c.IsActive)
                        {
                            <span class="status-badge status-badge-active">Active</span>
                        }
                        else
                        {
                            <span class="status-badge status-badge-inactive">Inactive</span>
                        }
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-navy" asp-page="Edit" asp-route-id="@c.CriteriaId">
                            <i class="bi bi-pencil"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
    const searchInput = document.getElementById('liveSearch');
    const roleInput = document.getElementById('liveRole');
    const roleFilter = document.getElementById('roleFilter');
    const roleButtons = roleFilter.querySelectorAll('.role-filter-btn');
    const rows = document.querySelectorAll('tbody tr[data-name]');

    function filterTable() {
        const searchVal = searchInput.value.toLowerCase().trim();
        const roleVal = roleInput.value.toLowerCase().trim();
        let visibleCount = 0;

        rows.forEach(row => {
            const name = row.dataset.name || '';
            const description = row.dataset.description || '';
            const role = row.dataset.role || '';

            const matchesSearch = name.includes(searchVal) || description.includes(searchVal);
            const matchesRole = roleVal === '' || role === roleVal;

            if (matchesSearch && matchesRole) {
                row.style.display = '';
                visibleCount++;
            } else {
                row.style.display = 'none';
            }
        });

        const emptyRow = document.getElementById('emptyRow');
        if (emptyRow) {
            emptyRow.style.display = visibleCount === 0 ? '' : 'none';
        }

        // Re-paginate against whatever the filter just left visible, so
        // Prev/Next and the page count match the filtered rows instead of
        // the full unfiltered table (and the nav disappears entirely once
        // the filtered set is small enough to fit on one page).
        if (window.TFPagination) window.TFPagination.init(document.querySelector('table.wlm-table'));
    }

    searchInput.addEventListener('input', filterTable);
    roleButtons.forEach(btn => {
        btn.addEventListener('click', () => {
            roleButtons.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            roleInput.value = btn.dataset.value;
            filterTable();
        });
    });
</script>
