@page
@model TM_PE.Pages.Admin.Criteria.CreateModel
@{
    ViewData["Title"] = "New Criteria";
    Layout = "_Admin";
}

<div class="tf-form-page">
    <div class="tf-form-card">

        <div class="tf-form-heading">New Criteria</div>

        <form method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3 align-items-end mb-3">
                <div class="col-md-8">
                    <label class="tf-label" asp-for="Item.CriteriaName">
                        Criteria Name <span class="tf-required">*</span>
                    </label>
                    <input class="form-control" asp-for="Item.CriteriaName" placeholder="e.g. Communication skills" />
                    <span asp-validation-for="Item.CriteriaName" class="text-danger small"></span>
                </div>

                @* Sits beside Criteria Name in the mockup rather than at the foot of the form. *@
                <div class="col-md-4">
                    <div class="d-flex align-items-center gap-2 pb-2">
                        <input class="form-check-input tf-check-input" type="checkbox" asp-for="Item.IsActive" />
                        <label class="tf-check-label mb-0" asp-for="Item.IsActive">Active</label>
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label class="tf-label" asp-for="Item.Description">Description</label>
                <textarea class="form-control" asp-for="Item.Description" rows="2"
                          placeholder="Enter a description"></textarea>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="tf-label" for="roleTypeDropdownBtn">
                        Role Type <span class="tf-required">*</span>
                    </label>
                    @{
                        var roleTypeOptions = new[] { ("OfficeStaff", "Office Staff"), ("FieldTechnician", "Field Technician") };
                        var currentRoleLabel = roleTypeOptions.FirstOrDefault(r => r.Item1 == Model.Item.RoleType.ToString()).Item2 ?? "Select role type";
                    }
                    <div class="dropdown">
                        <button type="button" class="btn status-dropdown-btn dropdown-toggle w-100" id="roleTypeDropdownBtn"
                                data-bs-toggle="dropdown" aria-expanded="false">
                            @currentRoleLabel
                        </button>
                        <ul class="dropdown-menu status-dropdown-menu w-100" aria-labelledby="roleTypeDropdownBtn">
                            @foreach (var r in roleTypeOptions)
                            {
                                <li><a class="dropdown-item @(Model.Item.RoleType.ToString() == r.Item1 ? "active" : "")" href="#" data-value="@r.Item1">@r.Item2</a></li>
                            }
                        </ul>
                    </div>
                    <input type="hidden" asp-for="Item.RoleType" id="roleTypeSelect" />
                </div>

                @*  <div class="col-md-6"><label class="form-label">Max Score (1-10)</label>
                <input class="form-control" type="number" min="1" max="10" asp-for="Item.MaxScore" /></div> *@

                <div class="col-md-6">
                    <label class="tf-label" asp-for="Item.Weight">Weight (%)</label>
                    <input class="form-control" type="number" step="0.5" min="0.5" max="100"
                           asp-for="Item.Weight" placeholder="0" />
                    <span asp-validation-for="Item.Weight" class="text-danger small"></span>

                    @* Bootstrap's colour utilities carry !important, so the
                       text-danger / text-muted toggle in the script below still
                       wins over .tf-form-hint's grey. *@
                    <div class="tf-form-hint fw-semibold" id="weightAvailableText"></div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a class="tf-btn-cancel" asp-page="Index">Cancel</a>
                <button type="submit" class="tf-btn-save">Save Criteria</button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/status-dropdown.js"></script>
    <script>
        (function () {
            const roleSelect = document.getElementById('roleTypeSelect');
            wireStatusDropdown('roleTypeDropdownBtn', roleSelect, { onChange: updateWeightAvailability });

            // Weight already committed to active criteria of each Role Type,
            // so the remaining-percent indicator below can update as the
            // manager picks a Role Type / types a Weight, mirroring what
            // CriteriaValidation will check on Save.
            const weightUsedByRole = {
                OfficeStaff: @Model.OfficeStaffWeightUsed.ToString(System.Globalization.CultureInfo.InvariantCulture),
                FieldTechnician: @Model.FieldTechnicianWeightUsed.ToString(System.Globalization.CultureInfo.InvariantCulture)
            };
            const weightInput = document.getElementById('Item_Weight');
            const weightAvailableText = document.getElementById('weightAvailableText');

            function fmt(n) {
                return Number(n.toFixed(2)).toString();
            }

            function updateWeightAvailability() {
                const roleLabel = roleSelect.value === 'FieldTechnician' ? 'Field Technician' : 'Office Staff';
                const used = weightUsedByRole[roleSelect.value] || 0;
                const available = Math.max(0, 100 - used);
                const entered = parseFloat(weightInput.value) || 0;
                const remaining = available - entered;

                weightAvailableText.textContent = 'Active ' + roleLabel + ' criteria are using ' + fmt(used) +
                    '% of 100% - ' + fmt(available) + '% available' +
                    (entered > 0 ? ' (' + fmt(remaining) + '% left if saved)' : '') + '.';
                weightAvailableText.classList.toggle('text-danger', remaining < 0);
                weightAvailableText.classList.toggle('text-muted', remaining >= 0);
            }

            weightInput.addEventListener('input', updateWeightAvailability);
            updateWeightAvailability();
        })();
    </script>
}
