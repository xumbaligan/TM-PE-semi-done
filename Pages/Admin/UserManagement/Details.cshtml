@page "{id:int}"
@model TM_PE.Pages.Admin.UserManagement.DetailsModel
@{
    ViewData["Title"] = "User Account Details";
    Layout = "_Admin";
    var emp = Model.Account.Employee;
}

<div class="mb-3">
    <h1 class="tf-page-title mb-1">User Account Details</h1>
    <p class="tf-page-sub mb-0">View and manage user account information and access settings.</p>
</div>
<hr class="page-divider" />

<div class="row g-4">
    <div class="col-lg-8">

        <div class="account-card mb-4">
            <div class="account-card-title">Account Overview</div>
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="d-flex align-items-center gap-3">
                        <div class="account-info-icon"><i class="bi bi-person-badge"></i></div>
                        <div class="overflow-hidden">
                            <div class="account-label">Username</div>
                            <div class="account-value">@Model.Account.Username</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="d-flex align-items-center gap-3">
                        <div class="account-info-icon"><i class="bi bi-calendar-check"></i></div>
                        <div class="overflow-hidden">
                            <div class="account-label">Hired At</div>
                            <div class="account-value">@(emp != null ? emp.HiredAt.ToString("MMMM d, yyyy") : "—")</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="d-flex align-items-center gap-3">
                        <div class="account-info-icon"><i class="bi bi-calendar3"></i></div>
                        <div class="overflow-hidden">
                            <div class="account-label">Account Created</div>
                            <div class="account-value">@Model.Account.DateCreated.ToString("MMMM d, yyyy")</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="d-flex align-items-center gap-3">
                        <div class="account-info-icon"><i class="bi bi-hourglass-split"></i></div>
                        <div class="overflow-hidden">
                            <div class="account-label">Last Login</div>
                            <div class="account-value">
                                @(Model.Account.LastLogin.HasValue
                                                                ? Model.Account.LastLogin.Value.ToString("MMMM d, yyyy h:mm tt")
                                                                : "Never")
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="account-card">
            <div class="account-card-title">Employee's Information</div>

            @if (emp == null)
            {
                <div class="text-muted">Employee record not found.</div>
            }
            else
            {
                <div class="account-employee-box">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="account-label">Full Name</div>
                            <div class="account-value account-value-caps">@emp.FullName</div>
                        </div>
                        <div class="col-md-6">
                            <div class="account-label">Email</div>
                            <div class="account-value">@emp.Email</div>
                        </div>
                        <div class="col-md-6">
                            <div class="account-label">Role</div>
                            <div class="account-value account-value-caps">@emp.RoleType</div>
                        </div>
                        <div class="col-md-6">
                            <div class="account-label">Status</div>
                            <div>
                                <span class="status-badge @(Model.Account.IsActive ? "status-badge-active" : "status-badge-inactive")">
                                    @(Model.Account.IsActive ? "Active" : "Disabled")
                                </span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="account-label">Department</div>
                            <div class="account-value account-value-caps">@(emp.Department?.DepartmentName ?? "—")</div>
                        </div>
                        @* Kept alongside the account status above - the two are set
                           independently, and only the account one is toggled here. *@
                        <div class="col-md-6">
                            <div class="account-label">Employee Status</div>
                            <div>
                                <span class="status-badge @(emp.IsActive ? "status-badge-active" : "status-badge-inactive")">
                                    @(emp.IsActive ? "Active" : "Inactive")
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="d-flex justify-content-end gap-2 mt-4">
                <form method="post" asp-page-handler="ToggleActive" class="m-0">
                    <button type="submit" class="tf-btn-cancel">
                        @(Model.Account.IsActive ? "Disable Account" : "Enable Account")
                    </button>
                </form>

                @if (emp != null)
                {
                    <a class="tf-btn-save" asp-page="/Admin/Employees/Edit" asp-route-id="@emp.EmployeeId">
                        Edit Employee
                    </a>
                }
            </div>
        </div>

    </div>

    <div class="col-lg-4">
        <div class="account-card">
            <div class="account-card-title">Reset Password</div>

            @if (!string.IsNullOrEmpty(Model.ResetMessage))
            {
                <div class="alert alert-success py-2 small">@Model.ResetMessage</div>
            }
            @if (!string.IsNullOrEmpty(Model.ResetError))
            {
                <div class="alert alert-danger py-2 small">@Model.ResetError</div>
            }

            <form method="post" asp-page-handler="ResetPassword">
                <div class="mb-3">
                    <label class="account-form-label" for="NewPassword">New Password</label>
                    <div class="account-input-group">
                        <input type="password" asp-for="NewPassword" maxlength="10"
                               inputmode="numeric" pattern="\d{8,10}" autocomplete="new-password" />
                        <button type="button" data-password-toggle="NewPassword" tabindex="-1" aria-label="Show password">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <div class="account-form-hint">8-10 digits, numbers only.</div>
                </div>

                <div class="mb-4">
                    <label class="account-form-label" for="ConfirmNewPassword">Confirm New Password</label>
                    <div class="account-input-group">
                        <input type="password" asp-for="ConfirmNewPassword" maxlength="10"
                               inputmode="numeric" pattern="\d{8,10}" autocomplete="new-password" />
                        <button type="button" data-password-toggle="ConfirmNewPassword" tabindex="-1" aria-label="Show password">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                </div>

                <div class="d-flex justify-content-end">
                    <button type="submit" class="account-btn-submit">Change password</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // One handler for both fields - each button names the input it controls
        // via data-password-toggle, the same pattern as the My Account page.
        document.querySelectorAll('[data-password-toggle]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var input = document.getElementById(btn.dataset.passwordToggle);
                if (!input) return;

                var icon = btn.querySelector('i');
                var isHidden = input.type === 'password';

                input.type = isHidden ? 'text' : 'password';
                icon.classList.toggle('bi-eye', !isHidden);
                icon.classList.toggle('bi-eye-slash', isHidden);
                btn.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');
            });
        });
    </script>
}
