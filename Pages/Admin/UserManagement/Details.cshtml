@page "{id:int}"
@model TM_PE.Pages.Admin.UserManagement.DetailsModel
@{
    ViewData["Title"] = "User Account Details";
    Layout = "_Admin";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-person-badge"></i> User Account Details</h2>
    <a class="btn btn-outline-secondary" asp-page="Index"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card p-4 mb-4">
            <h5 class="mb-3">Account</h5>
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="text-muted small">Username</div>
                    <div class="fw-semibold"><code>@Model.Account.Username</code></div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted small">Status</div>
                    <div>
                        @if (Model.Account.IsActive)
                        {
                            <span class="badge badge-soft-success">Active</span>
                        }
                        else
                        {
                            <span class="badge badge-soft-warning">Disabled</span>
                        }
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted small">Created</div>
                    <div class="fw-semibold">@Model.Account.DateCreated.ToString("MMMM d, yyyy")</div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted small">Last Login</div>
                    <div class="fw-semibold">@(Model.Account.LastLogin.HasValue? Model.Account.LastLogin.Value.ToString("MMMM d, yyyy h:mm tt") : "Never")</div>
                </div>
            </div>

            <form method="post" asp-page-handler="ToggleActive" class="mt-3">
                <button type="submit" class="btn btn-sm @(Model.Account.IsActive ? "btn-outline-warning" : "btn-outline-success")">
                    @(Model.Account.IsActive ? "Disable Account" : "Enable Account")
                </button>
            </form>
        </div>

        <div class="card p-4">
            <h5 class="mb-3">Reset Password</h5>
            @if (!string.IsNullOrEmpty(Model.ResetMessage))
            {
                <div class="alert alert-success py-2 small">@Model.ResetMessage</div>
            }
            @if (!string.IsNullOrEmpty(Model.ResetError))
            {
                <div class="alert alert-danger py-2 small">@Model.ResetError</div>
            }
            <form method="post" asp-page-handler="ResetPassword">
                <div class="mb-2">
                    <label class="form-label">New Password</label>
                    <input class="form-control" type="text" asp-for="NewPassword" maxlength="10" inputmode="numeric" pattern="\d{8,10}" />
                    <div class="form-text">8-10 digits, numbers only.</div>
                </div>
                <div class="mb-2">
                    <label class="form-label">Confirm New Password</label>
                    <input class="form-control" type="text" asp-for="ConfirmNewPassword" maxlength="10" inputmode="numeric" pattern="\d{8,10}" />
                </div>
                <button class="btn btn-primary btn-sm">Reset Password</button>
            </form>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card p-4">
            <h5 class="mb-3">Employee Information</h5>
            @if (Model.Account.Employee == null)
            {
                <div class="text-muted">Employee record not found.</div>
            }
            else
            {
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="text-muted small">Full Name</div>
                        <div class="fw-semibold">@Model.Account.Employee.FullName</div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted small">Email</div>
                        <div class="fw-semibold">@Model.Account.Employee.Email</div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted small">Role Type</div>
                        <div><span class="badge badge-soft-primary">@Model.Account.Employee.RoleType</span></div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted small">Department</div>
                        <div class="fw-semibold">@(Model.Account.Employee.Department?.DepartmentName ?? "—")</div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted small">Hired At</div>
                        <div class="fw-semibold">@Model.Account.Employee.HiredAt.ToString("MMMM d, yyyy")</div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted small">Employee Status</div>
                        <div>
                            @if (Model.Account.Employee.IsActive)
                            {
                                <span class="badge badge-soft-success">Active</span>
                            }
                            else
                            {
                                <span class="badge badge-soft-warning">Inactive</span>
                            }
                        </div>
                    </div>
                </div>
                <a class="btn btn-sm btn-outline-secondary mt-3" asp-page="/Admin/Employees/Edit" asp-route-id="@Model.Account.Employee.EmployeeId">
                    <i class="bi bi-pencil"></i> Edit in Employee Management
                </a>
            }
        </div>
    </div>
</div>
