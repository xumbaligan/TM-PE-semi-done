@page
@model TM_PE.Pages.Admin.UserManagement.IndexModel
@{
    ViewData["Title"] = "User Management";
    Layout = "_Admin";

    string RoleBadgeClass(TM_PE.Model.RoleType rt) => rt switch
    {
        TM_PE.Model.RoleType.FieldTechnician => "role-badge-field-technician",
        TM_PE.Model.RoleType.OfficeStaff => "role-badge-office-staff",
        TM_PE.Model.RoleType.Manager => "role-badge-manager",
        TM_PE.Model.RoleType.Admin => "role-badge-admin",
        _ => "role-badge-office-staff"
    };
}

<div class="mb-3">
    <h1 class="tf-page-title mb-1">User Management</h1>
    <p class="tf-page-sub mb-0">Login accounts for every employee.</p>
</div>
<hr class="page-divider" />

<form method="get" class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <div class="search-input-group flex-grow-1" style="max-width:400px;">
        <i class="bi bi-search"></i>
        <input name="search" id="liveSearch" value="@Model.Search" placeholder="Search by username or employee..." />
    </div>
    <input type="hidden" name="role" id="liveRole" value="@Model.Role" />
    <div class="role-filter" id="roleFilter">
        <button type="button" class="role-filter-btn @(string.IsNullOrEmpty(Model.Role) ? "active" : "")" data-value="">All Roles</button>
        <button type="button" class="role-filter-btn @(Model.Role == "Admin" ? "active" : "")" data-value="Admin">Admin</button>
        <button type="button" class="role-filter-btn @(Model.Role == "Manager" ? "active" : "")" data-value="Manager">Manager</button>
        <button type="button" class="role-filter-btn @(Model.Role == "OfficeStaff" ? "active" : "")" data-value="OfficeStaff">Office Staff</button>
        <button type="button" class="role-filter-btn @(Model.Role == "FieldTechnician" ? "active" : "")" data-value="FieldTechnician">Field Technician</button>
    </div>
    <a class="btn btn-navy ms-auto" asp-page="Create"><i class="bi bi-plus-lg"></i> New User Account</a>
</form>

<div class="table-responsive wlm-card tf-cardify">
    <table class="table table-hover wlm-table wlm-table-fixed mb-0 align-middle tf-mc-table">
        <thead>
            <tr>
                <th style="width:15%">Username</th>
                <th style="width:15%">Employee</th>
                <th style="width:15%">Role</th>
                <th style="width:15%">Created</th>
                <th style="width:15%">Last Login</th>
                <th style="width:15%">Status</th>
                <th class="text-end" style="width:10%">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Accounts.Any())
            {
                <tr id="emptyRow" class="tf-mc-empty">
                    <td colspan="7" class="text-center text-muted py-4">No user accounts yet.</td>
                </tr>
            }
            else
            {
                <tr id="emptyRow" class="tf-mc-empty" style="display:none;">
                    <td colspan="7" class="text-center text-muted py-4">No user accounts found</td>
                </tr>
                @foreach (var a in Model.Accounts)
                {
                    <tr data-username="@a.Username.ToLower()"
                        data-employee="@((a.Employee?.FullName ?? "").ToLower())"
                        data-role="@(a.Employee?.RoleType.ToString() ?? "")">
                        <td class="tf-mc-sub"><code class="username-text">@a.Username</code></td>
                        <td class="tf-mc-title">
                            @if (a.Employee != null)
                            {
                                <div class="d-flex align-items-center gap-2">
                                    <div class="wlm-avatar">
                                        @(string.Join("", a.Employee.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(n => char.ToUpper(n[0]))))
                                    </div>
                                    <span>@a.Employee.FullName</span>
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="tf-mc-badge">
                            @if (a.Employee != null)
                            {
                                <span class="badge rounded-pill @RoleBadgeClass(a.Employee.RoleType)">
                                    @a.Employee.RoleType
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-muted tf-mc-hide">@a.DateCreated.ToString("MMM d, yyyy")</td>
                        <td class="text-muted tf-mc-hide">@(a.LastLogin.HasValue ? a.LastLogin.Value.ToString("MMM d, yyyy h:mm tt") : "Never")</td>
                        <td class="tf-mc-badge">
                            @if (a.IsActive)
                            {
                                <span class="status-badge status-badge-active">Active</span>
                            }
                            else
                            {
                                <span class="status-badge status-badge-inactive">Disabled</span>
                            }
                        </td>
                        <td class="text-end tf-mc-action">
                            <a class="btn btn-sm btn-outline-navy" asp-page="Details" asp-route-id="@a.UserAccountID">
                                <i class="bi bi-eye tf-mc-icon-full"></i><span class="tf-mc-label"> View</span><i class="bi bi-chevron-right tf-mc-chevron"></i>
                            </a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        const searchInput = document.getElementById('liveSearch');
        const roleInput = document.getElementById('liveRole');
        const roleFilter = document.getElementById('roleFilter');
        const roleButtons = roleFilter.querySelectorAll('.role-filter-btn');
        const rows = document.querySelectorAll('tbody tr[data-username]');

        function filterTable() {
            const searchVal = searchInput.value.toLowerCase().trim();
            const roleVal = roleInput.value.toLowerCase().trim();
            let visibleCount = 0;

            rows.forEach(row => {
                const username = row.dataset.username || '';
                const employee = row.dataset.employee || '';
                const role = row.dataset.role || '';

                const matchesSearch = username.includes(searchVal) || employee.includes(searchVal);
                const matchesRole = roleVal === '' || role.toLowerCase() === roleVal;

                if (matchesSearch && matchesRole) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            const emptyRow = document.getElementById('emptyRow');
            if (emptyRow) {
                emptyRow.style.display = visibleCount === 0 ? '' : 'none';
            }

            // Re-paginate against whatever the filter just left visible, so
            // Prev/Next and the page count match the filtered rows instead of
            // the full unfiltered table (and the nav disappears entirely once
            // the filtered set is small enough to fit on one page).
            if (window.TFPagination) window.TFPagination.init(document.querySelector('table.wlm-table'));
        }

        searchInput.addEventListener('input', filterTable);
        roleButtons.forEach(btn => {
            btn.addEventListener('click', () => {
                roleButtons.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                roleInput.value = btn.dataset.value;
                filterTable();
            });
        });
    </script>
}
