@page
@model TM_PE.Pages.Admin.UserManagement.CreateModel
@{
    ViewData["Title"] = "New User Account";
    Layout = "_Admin";
}

<div class="tf-form-page">
    <div class="tf-form-card">

        <div class="tf-form-heading">New User Account</div>

        <form method="post" id="userForm">

            <div class="mb-3">
                <label class="tf-label" asp-for="EmployeeID">
                    Select Employee <span class="tf-required">*</span>
                </label>

                <select class="form-select" asp-for="EmployeeID" id="employeeSelect">
                    <option value="">Select an employee</option>
                    @foreach (var emp in Model.EmployeeList)
                    {
                        <option value="@emp.EmployeeId" data-role="@emp.RoleType" data-id="@emp.EmployeeId">
                            @emp.FullName (@emp.RoleType)
                        </option>
                    }
                </select>

                <span asp-validation-for="EmployeeID" class="text-danger small"></span>

                @if (!Model.EmployeeList.Any())
                {
                    <div class="tf-hint mt-2 text-warning">
                        <i class="bi bi-exclamation-circle"></i>
                        <span>Every active employee already has a user account.</span>
                    </div>
                }
            </div>

            <div class="mb-3">
                <label class="tf-label">Username</label>

                @* Filled in by the script below from the selected employee's role +
                   id; disabled so it never posts - the server derives it again. *@
                <input class="form-control tf-input-locked" id="usernamePreview" disabled
                       placeholder="Auto generated username for employee" />

                <div class="tf-hint mt-2">
                    <i class="bi bi-info-circle"></i>
                    <span>
                        Fixed automatically as <code>@TM_PE.Model.UsernamePolicy.CompanyName-{Role}{ID}</code>
                        (e.g. <code>Pakonek-T001</code> for Field Technician #1) &mdash; this can't be changed later.
                    </span>
                </div>
            </div>

            <div class="mb-3">
                <label class="tf-label" asp-for="Password">
                    Password <span class="tf-required">*</span>
                </label>

                <input class="form-control" type="text" asp-for="Password" maxlength="10"
                       inputmode="numeric" pattern="\d{8,10}" placeholder="Enter a password" />

                <span asp-validation-for="Password" class="text-danger small"></span>
                <div class="tf-form-hint">8-10 digits, numbers only.</div>
            </div>

            <div class="mb-3">
                <label class="tf-label" asp-for="ConfirmPassword">
                    Confirm Password <span class="tf-required">*</span>
                </label>

                <input class="form-control" type="text" asp-for="ConfirmPassword" maxlength="10"
                       inputmode="numeric" pattern="\d{8,10}" placeholder="Confirm your password" />

                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a class="tf-btn-cancel" asp-page="Index">Cancel</a>
                <button type="submit" class="tf-btn-save" @(Model.EmployeeList.Any() ? "" : "disabled")>
                    Create Account
                </button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const employeeSelect = document.getElementById('employeeSelect');
            const usernamePreview = document.getElementById('usernamePreview');
            const roleInitials = { FieldTechnician: 'T', OfficeStaff: 'O', Manager: 'M', Admin: 'A' };

            function updatePreview() {
                const opt = employeeSelect.options[employeeSelect.selectedIndex];
                if (!opt || !opt.value) {
                    usernamePreview.value = '';
                    return;
                }
                const role = opt.dataset.role;
                const id = opt.dataset.id.padStart(3, '0');
                const initial = roleInitials[role] || 'X';
                usernamePreview.value = `Pakonek-${initial}${id}`;
            }

            employeeSelect.addEventListener('change', updatePreview);
            updatePreview();

            // Digits-only enforcement as the person types (server still re-validates).
            document.querySelectorAll('input[pattern]').forEach(input => {
                input.addEventListener('input', function () {
                    this.value = this.value.replace(/[^0-9]/g, '');
                });
            });
        })();
    </script>
}
