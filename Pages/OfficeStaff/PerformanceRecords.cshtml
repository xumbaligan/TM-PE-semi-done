@page
@model TM_PE.Pages.OfficeStaff.PerformanceRecordsModel
@{
    ViewData["Title"] = "My Performance Records";
    Layout = "_OfficeStaffLayout";
    var emp = Model.Employee;
    var last = Model.LastEvaluation;
}

@{
    // EvaluationScoring.RatingBadgeClass returns Bootstrap colour tokens; map
    // them onto the .vm-status-* pills the rest of the restyled app uses so
    // all five rating bands stay visually distinct.
    string RatingPill(string rating) => TM_PE.Model.EvaluationScoring.RatingBadgeClass(rating) switch
    {
        "success" => "vm-status-success",
        "primary" => "vm-status-primary",
        "info" => "vm-status-info",
        "warning" => "vm-status-warning",
        "danger" => "vm-status-danger",
        _ => "vm-status-pending"
    };
}

<div class="mb-3">
    <h1 class="tf-page-title mb-1">My Performance Records</h1>
    <p class="tf-page-sub mb-0">View your performance records and evaluation results.</p>
</div>
<hr class="page-divider" />

<div class="row g-3 mb-3">

    @* ===================== Overall rating ===================== *@
    <div class="col-lg-7">
        <div class="vm-card h-100">
            <div class="row g-3 align-items-center h-100">
                <div class="col-md-6">
                    <div class="tf-page-title mb-2">@emp.FullName</div>
                    <span class="vm-pill">Office Staff</span>
                </div>
                <div class="col-md-6 vm-col-divider text-center">
                    <div class="eval-score-label">Overall Rating</div>
                    <div class="eval-score-value">@Model.OverallScore.ToString("0.##")</div>
                    <div class="d-flex justify-content-center">
                        <partial name="_Stars" model="Model.OverallStars" />
                    </div>
                    <div class="eval-score-out-of mt-1">out of 4 &mdash; across all finalized evaluations</div>
                    <div class="mt-2">
                        <span class="vm-status @RatingPill(Model.OverallRating)">@Model.OverallRating</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ===================== Summary tiles ===================== *@
    <div class="col-lg-5">
        <div class="row g-3" id="statTiles">
            <div class="col-6">
                <div class="eval-stat eval-stat-primary d-flex align-items-start gap-2">
                    <div class="stat-icon icon-palette-primary"><i class="bi bi-clipboard-check"></i></div>
                    <div class="overflow-hidden">
                        <div class="stat-label">Evaluations Completed</div>
                        <div class="stat-value">@Model.EvaluationsCompleted</div>
                    </div>
                </div>
            </div>
            @* Office task tiles below are clickable - same drill-down pattern as
               Manager > Performance Evaluation's stat tiles - but always scoped
               server-side to this logged-in employee's own tasks (see
               PerformanceRecordsModel.OnGetRecordsAsync), never another
               employee's. *@
            <div class="col-6">
                <div class="eval-stat eval-stat-success d-flex align-items-start gap-2" id="statTile-completed" data-metric="completed">
                    <div class="stat-icon icon-palette-success"><i class="bi bi-check2-circle"></i></div>
                    <div class="overflow-hidden">
                        <div class="stat-label">Completed Job/Task</div>
                        <div class="stat-value">@Model.Stats.CompletedJobsTasks</div>
                    </div>
                </div>
            </div>
            <div class="col-6">
                <div class="eval-stat eval-stat-warning d-flex align-items-start gap-2" id="statTile-ontime" data-metric="ontime">
                    <div class="stat-icon icon-palette-warning"><i class="bi bi-clock-history"></i></div>
                    <div class="overflow-hidden">
                        <div class="stat-label">On-time Rate</div>
                        <div class="stat-value">@Model.Stats.OnTimeRate.ToString("0")%</div>
                    </div>
                </div>
            </div>
            <div class="col-6">
                <div class="eval-stat eval-stat-danger d-flex align-items-start gap-2" id="statTile-rejected" data-metric="rejected">
                    <div class="stat-icon icon-palette-danger"><i class="bi bi-hand-thumbs-down"></i></div>
                    <div class="overflow-hidden">
                        <div class="stat-label">Rejected Activities</div>
                        <div class="stat-value">@Model.Stats.RejectedActivities</div>
                    </div>
                </div>
            </div>
            @* The mockup only had room for four tiles; Cancelled is the fifth
               metric this page has always shown, so it keeps its own row. *@
            <div class="col-6">
                <div class="eval-stat eval-stat-warning d-flex align-items-start gap-2" id="statTile-overdue" data-metric="overdue">
                    <div class="stat-icon icon-palette-warning"><i class="bi bi-exclamation-triangle"></i></div>
                    <div class="overflow-hidden">
                        <div class="stat-label">Overdue Task</div>
                        <div class="stat-value">@Model.Stats.OverdueTasks</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@* ===================== Last evaluation ===================== *@
<div class="vm-card mb-3">
    <div class="vm-card-title">Last Evaluation</div>
    @if (last == null)
    {
        <span class="tf-empty-msg">You don't have any finalized evaluations yet.</span>
    }
    else
    {
        <div class="row g-3">
            <div class="col-md-3">
                <div class="vm-label">Evaluation Period</div>
                <div class="vm-value">
                    <i class="bi bi-calendar3"></i>
                    @last.EvaluationPeriod
                </div>
            </div>
            <div class="col-md-3 vm-col-divider">
                <div class="vm-label">Date of Evaluation</div>
                <div class="vm-value">
                    <i class="bi bi-calendar-event"></i>
                    @last.EvaluationDate.ToString("MMMM d, yyyy")
                </div>
            </div>
            <div class="col-md-3 vm-col-divider">
                <div class="vm-label">Overall Rating</div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <partial name="_Stars" model="last.OverallStars" />
                    <span class="vm-status @RatingPill(last.OverallRating)">@last.OverallRating</span>
                </div>
            </div>
            <div class="col-md-3 vm-col-divider">
                <div class="vm-label">Score</div>
                <div class="vm-value">@last.OverallScore.ToString("0.##") / 4</div>
            </div>
        </div>
    }
</div>

@* ===================== Evaluation history ===================== *@
<div class="vm-card mb-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
        <div class="vm-card-label">Evaluation History</div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <label class="vm-label mb-0" for="periodDropdownBtn">Evaluation Period</label>
            <div class="dropdown">
                <button type="button" class="btn status-dropdown-btn dropdown-toggle" id="periodDropdownBtn"
                        data-bs-toggle="dropdown" aria-expanded="false" style="width:auto">
                    All periods
                </button>
                <ul class="dropdown-menu status-dropdown-menu" aria-labelledby="periodDropdownBtn">
                    <li><a class="dropdown-item active" href="#" data-value="">All periods</a></li>
                    @foreach (var p in Model.Periods)
                    {
                        <li><a class="dropdown-item" href="#" data-value="@p">@p</a></li>
                    }
                </ul>
            </div>
            <input type="hidden" id="periodFilter" value="" />

            <label class="vm-label mb-0" for="yearDropdownBtn">Year</label>
            <div class="dropdown">
                <button type="button" class="btn status-dropdown-btn dropdown-toggle" id="yearDropdownBtn"
                        data-bs-toggle="dropdown" aria-expanded="false" style="width:auto">
                    All years
                </button>
                <ul class="dropdown-menu status-dropdown-menu" aria-labelledby="yearDropdownBtn">
                    <li><a class="dropdown-item active" href="#" data-value="">All years</a></li>
                    @foreach (var y in Model.Years)
                    {
                        <li><a class="dropdown-item" href="#" data-value="@y">@y</a></li>
                    }
                </ul>
            </div>
            <input type="hidden" id="yearFilter" value="" />
        </div>
    </div>

    <div class="table-responsive">
        <table class="table vm-table-plain wlm-table-fixed align-middle mb-0">
            <thead>
                <tr>
                    <th style="width:39%">Evaluation Period</th>
                    <th style="width:20%">Overall Rating</th>
                    <th style="width:13%">Score</th>
                    <th style="width:18%">Evaluated By</th>
                    <th class="text-end" style="width:10%">Action</th>
                </tr>
            </thead>
            <tbody id="historyBody">
                @if (!Model.Evaluations.Any())
                {
                    <tr><td colspan="5" class="text-center tf-empty-msg py-4">No evaluations on record yet.</td></tr>
                }
                else
                {
                    @foreach (var e in Model.Evaluations)
                    {
                        var results = TM_PE.Pages.Manager.PerformanceEvaluation.IndexModel.BuildResultViews(e);
                        var evalStats = Model.EvaluationStats.GetValueOrDefault(e.EvaluationID) ?? new TM_PE.Model.EmployeePerformanceStats();

                        <tr data-year="@e.EvaluationDate.Year" data-period="@e.EvaluationPeriod">
                            <td>
                                <div class="vm-value">@e.EvaluationPeriod</div>
                                <div class="vm-file-meta">@e.EvaluationDate.ToString("MMMM d, yyyy")</div>
                            </td>
                            <td>
                                <partial name="_Stars" model="e.OverallStars" />
                                <div class="mt-1">
                                    <span class="vm-status @RatingPill(e.OverallRating)">@e.OverallRating</span>
                                </div>
                            </td>
                            <td><div class="vm-value">@e.OverallScore.ToString("0.##") <span class="vm-file-meta">/ 4</span></div></td>
                            <td><div class="vm-value">@e.EvaluatorName</div></td>
                            <td class="text-end">
                                <button type="button" class="vm-btn-sm w-auto view-evaluation-btn"
                                        data-bs-toggle="modal" data-bs-target="#evaluationModal"
                                        data-employee="@emp.FullName"
                                        data-role="Office Staff"
                                        data-role-type="OfficeStaff"
                                        data-period="@e.EvaluationPeriod"
                                        data-evaluator="@e.EvaluatorName"
                                        data-date="@e.EvaluationDate.ToString("MMMM d, yyyy")"
                                        data-overall-score="@e.OverallScore.ToString("0.##")"
                                        data-rating="@e.OverallRating"
                                        data-status="@e.EvaluationStatus"
                                        data-feedback="@e.GeneralFeedback"
                                        data-results="@System.Text.Json.JsonSerializer.Serialize(results)"
                                        data-completed="@evalStats.CompletedJobsTasks"
                                        data-ontime="@evalStats.OnTimeRate.ToString("0")"
                                        data-rescheduled="@evalStats.Rescheduled"
                                        data-cancelled="@evalStats.Cancelled"
                                        data-rejected="@evalStats.RejectedActivities"
                                        data-overdue="@evalStats.OverdueTasks"
                                        title="View full evaluation">
                                    <i class="bi bi-eye"></i> View
                                </button>
                            </td>
                        </tr>
                    }
                    <tr id="noYearMatch" class="d-none">
                        <td colspan="5" class="text-center tf-empty-msg py-4">No evaluations for the selected filters.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* ===================== Modal: stat tile drill-down list ===================== *@
<div class="modal fade" id="recordsModal" tabindex="-1" aria-labelledby="recordsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="recordsModalLabel">Records</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table align-middle table-sm">
                        <thead>
                            <tr class="text-muted small">
                                <th>Type</th>
                                <th>Id no.</th>
                                <th>Name</th>
                                <th>Status</th>
                                <th>Date</th>
                                <th id="recordsOnTimeHeader" class="d-none">On Time</th>
                                <th id="recordsActionHeader" class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody id="recordsTableBody">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@* ===================== Modal: one record's remarks / uploaded file(s) ===================== *@
<div class="modal fade" id="recordDetailModal" tabindex="-1" aria-labelledby="recordDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="recordDetailModalLabel">Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="recordDetailBody">
            </div>
        </div>
    </div>
</div>

<partial name="_EvaluationModal" />

@section Scripts {
    <script src="~/js/star-rating.js" asp-append-version="true"></script>
    <script src="~/js/evaluation-modal.js" asp-append-version="true"></script>
    <script src="~/js/status-dropdown.js"></script>
    <script>
        (function () {
            const yearFilter = document.getElementById('yearFilter');
            const periodFilter = document.getElementById('periodFilter');
            const noMatch = document.getElementById('noYearMatch');
            if (!yearFilter || !periodFilter) return;

            function applyFilters() {
                const year = yearFilter.value;
                const period = periodFilter.value;
                let visible = 0;

                document.querySelectorAll('#historyBody tr[data-year]').forEach(row => {
                    const show = (!year || row.dataset.year === year) && (!period || row.dataset.period === period);
                    row.classList.toggle('d-none', !show);
                    if (show) visible++;
                });

                if (noMatch) noMatch.classList.toggle('d-none', visible > 0);

                // Re-paginate against whatever the filter just left visible,
                // so Prev/Next and the page count match the filtered rows
                // instead of the full unfiltered history (and the nav
                // disappears entirely once the filtered set fits one page).
                if (window.TFPagination) window.TFPagination.init(document.querySelector('table.vm-table-plain'));
            }

            wireStatusDropdown('yearDropdownBtn', yearFilter, { onChange: applyFilters });
            wireStatusDropdown('periodDropdownBtn', periodFilter, { onChange: applyFilters });
        })();

        // ---- Stat tile drill-down (Completed / On-time / Rejected / Overdue) ----
        // Same pattern as Manager > Performance Evaluation's stat tiles, minus the
        // employee picker - the clicked tile always drills into this logged-in
        // employee's own office tasks (see PerformanceRecordsModel.OnGetRecordsAsync).
        (function () {
            const recordsModalEl = document.getElementById('recordsModal');
            const recordsModal = new bootstrap.Modal(recordsModalEl);
            const recordsModalLabel = document.getElementById('recordsModalLabel');
            const recordsTableBody = document.getElementById('recordsTableBody');
            const recordsOnTimeHeader = document.getElementById('recordsOnTimeHeader');
            const recordsActionHeader = document.getElementById('recordsActionHeader');

            const recordDetailModalEl = document.getElementById('recordDetailModal');
            const recordDetailModal = new bootstrap.Modal(recordDetailModalEl);
            const recordDetailModalLabel = document.getElementById('recordDetailModalLabel');
            const recordDetailBody = document.getElementById('recordDetailBody');

            const metricLabels = {
                completed: 'Completed Job/Task',
                ontime: 'On-time Rate',
                rejected: 'Rejected Activities',
                overdue: 'Overdue Task'
            };

            const imageExtensions = ['.jpg', '.jpeg', '.png', '.gif', '.webp', '.bmp'];
            function isImageFile(fileName) {
                const ext = (fileName.match(/\.[^.]+$/) || [''])[0].toLowerCase();
                return imageExtensions.includes(ext);
            }
            function fileUrl(filePath) {
                return '/' + String(filePath).replace(/\\/g, '/').replace(/^\/+/, '');
            }
            function renderFile(file) {
                const url = fileUrl(file.filePath);
                if (isImageFile(file.fileName)) {
                    return `<a href="${url}" target="_blank" rel="noopener" class="d-inline-block me-2 mb-2">
                        <img src="${url}" alt="${file.fileName}" style="width:100px;height:100px;object-fit:cover;border-radius:.375rem;border:1px solid #dee2e6;" />
                    </a>`;
                }
                return `<a href="${url}" target="_blank" rel="noopener" class="d-inline-flex align-items-center gap-1 me-2 mb-2 btn btn-sm btn-outline-secondary">
                    <i class="bi bi-file-earmark-arrow-down"></i> ${file.fileName}
                </a>`;
            }

            let currentRecords = [];

            function badgeClassFor(status) {
                switch (status) {
                    case 'Completed': return 'bg-success-subtle text-success';
                    case 'Completed Late': return 'bg-warning-subtle text-warning-emphasis';
                    case 'In Progress': return 'bg-info-subtle text-info';
                    case 'Cancelled': return 'bg-danger-subtle text-danger';
                    case 'Rescheduled':
                    case 'Reschedule Request': return 'bg-warning-subtle text-warning-emphasis';
                    case 'Overdue': return 'bg-danger-subtle text-danger-emphasis';
                    case 'Rejected': return 'bg-danger-subtle text-danger';
                    default: return 'bg-secondary-subtle text-secondary';
                }
            }

            function renderRecordsTable(metric) {
                recordsTableBody.innerHTML = '';
                recordsOnTimeHeader.classList.toggle('d-none', metric !== 'ontime');
                recordsActionHeader.classList.remove('d-none');

                if (currentRecords.length === 0) {
                    const colspan = (metric === 'ontime' ? 1 : 0) + 5;
                    recordsTableBody.innerHTML = `<tr><td colspan="${colspan}" class="text-muted text-center py-3">No records found.</td></tr>`;
                    if (window.TFPagination) window.TFPagination.init(recordsTableBody.closest('table'));
                    return;
                }

                currentRecords.forEach(function (item, index) {
                    const tr = document.createElement('tr');
                    let onTimeCell = '';
                    if (metric === 'ontime') {
                        const onTimeClass = item.onTime === 'Yes' ? 'text-success' : 'text-danger';
                        onTimeCell = `<td class="${onTimeClass} fw-semibold">${item.onTime ?? '—'}</td>`;
                    }
                    tr.innerHTML = `
                        <td>${item.type}</td>
                        <td class="text-muted">${item.number}</td>
                        <td>${item.title}</td>
                        <td><span class="badge rounded-pill ${badgeClassFor(item.status)} px-2 py-1">${item.status}</span></td>
                        <td class="text-muted">${item.dateLabel ?? '—'}</td>
                        ${onTimeCell}
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-link text-secondary p-1 record-view-btn" data-index="${index}" title="View">
                                <i class="bi bi-eye"></i>
                            </button>
                        </td>
                    `;
                    recordsTableBody.appendChild(tr);
                });

                if (window.TFPagination) window.TFPagination.init(recordsTableBody.closest('table'));
            }

            function showRecordDetail(item) {
                recordDetailModalLabel.textContent = `${item.type} ${item.number}`;

                const activitiesHtml = (item.activities && item.activities.length)
                    ? item.activities.map(function (a) {
                        const filesHtml = a.files && a.files.length
                            ? a.files.map(renderFile).join('')
                            : '<span class="text-muted small">No uploaded file.</span>';
                        return `
                            <div class="border rounded p-3 mb-2">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div class="fw-semibold">${a.activityName}</div>
                                    <span class="badge rounded-pill ${badgeClassFor(a.status)} px-2 py-1">${a.status}</span>
                                </div>
                                <div class="text-muted small mb-1">Feedback</div>
                                <div class="mb-2">${a.feedback ?? '<span class="text-muted">No feedback.</span>'}</div>
                                <div class="text-muted small mb-1">Uploaded File</div>
                                <div>${filesHtml}</div>
                            </div>
                        `;
                    }).join('')
                    : '<span class="text-muted">No activities recorded.</span>';
                recordDetailBody.innerHTML = activitiesHtml;

                recordsModal.hide();
                recordDetailModal.show();
            }

            recordDetailModalEl.addEventListener('hidden.bs.modal', function () {
                recordsModal.show();
            });

            recordsTableBody.addEventListener('click', function (e) {
                const btn = e.target.closest('.record-view-btn');
                if (!btn) return;
                const item = currentRecords[parseInt(btn.dataset.index, 10)];
                if (item) showRecordDetail(item);
            });

            document.querySelectorAll('#statTiles .eval-stat[data-metric]').forEach(function (tile) {
                tile.addEventListener('click', async function () {
                    const metric = tile.dataset.metric;
                    const params = new URLSearchParams({ handler: 'Records', metric: metric });

                    recordsModalLabel.textContent = metricLabels[metric] || 'Records';
                    recordsTableBody.innerHTML = '<tr><td colspan="6" class="text-muted text-center py-3">Loading...</td></tr>';
                    recordsModal.show();

                    try {
                        const response = await fetch(window.location.pathname + '?' + params.toString(), {
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        });
                        currentRecords = response.ok ? await response.json() : [];
                    } catch {
                        currentRecords = [];
                    }

                    renderRecordsTable(metric);
                });
            });
        })();
    </script>
}
