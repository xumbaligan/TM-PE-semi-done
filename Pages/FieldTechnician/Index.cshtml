@page
@model TM_PE.Pages.FieldTechnician.IndexModel

@{
    ViewData["Title"] = "My Job Orders";
    Layout = "_FieldTechnicianLayout";
}

<div class="mb-3">
    <h1 class="tf-page-title mb-1">My Job Orders</h1>
    <p class="tf-page-sub mb-0">Viewing as <strong>@Model.CurrentEmployee.FullName</strong></p>
</div>
<hr class="page-divider" />

<div class="wlm-card tf-cardify">
    <div class="card-body p-0">

        @if (!Model.AssignedJobOrders.Any())
        {
            <div class="p-4 text-muted text-center tf-empty-state">You don't have any assigned job orders yet.</div>
        }
        else
        {
            <div class="table-responsive">
            <table class="table align-middle wlm-table wlm-table-fixed mb-0 tf-mc-table">
                <thead>
                    <tr>
                        <th class="ps-3" style="width:15%">Job Order</th>
                        <th style="width:15%">Job Type</th>
                        <th style="width:15%">Date</th>
                        <th style="width:15%">Status</th>
                        <th style="width:15%">Assigned By</th>
                        <th style="width:15%">Your Role</th>
                        <th class="text-end pe-3" style="width:10%">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ticket in Model.AssignedJobOrders)
                    {
                        var badgeClass = ticket.DisplayStatus switch
                        {
                            "Completed" => "bg-success-subtle text-success",
                            "Completed Late" => "bg-warning-subtle text-warning-emphasis",
                            "In Progress" => "bg-info-subtle text-info",
                            "Cancelled" => "bg-danger-subtle text-danger",
                            "Rescheduled" => "bg-warning-subtle text-warning-emphasis",
                            "Overdue" => "bg-danger-subtle text-danger-emphasis",
                            _ => "bg-secondary-subtle text-secondary"
                        };
                        var isLeader = Model.LeaderOn.Contains(ticket.JobTicketID);

                        <tr>
                            <td class="ps-3 tf-mc-sub">
                                <div class="fw-semibold">@ticket.TicketNumber</div>
                            </td>
                            <td class="tf-mc-title">@ticket.JobType</td>
                            <td class="tf-mc-hide">@ticket.ServiceDate.ToString("M/d/yyyy")</td>
                            <td class="tf-mc-badge"><span class="status-badge @badgeClass">@ticket.DisplayStatus</span></td>
                            <td class="text-muted tf-mc-hide">@(ticket.AssignedByEmployee?.FullName ?? "—")</td>
                            <td class="tf-mc-badge">
                                @if (isLeader)
                                {
                                    <span class="badge rounded-pill role-badge-office-staff">Leader</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark border">Member</span>
                                }
                            </td>
                            <td class="text-end pe-3 tf-mc-action">
                                <a asp-page="./Details" asp-route-id="@ticket.JobTicketID" class="btn btn-sm btn-outline-navy"
                                   aria-label="View @ticket.TicketNumber">
                                    <i class="bi bi-eye tf-mc-icon-full"></i><span class="tf-mc-label"> View</span><i class="bi bi-chevron-right tf-mc-chevron"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }

    </div>
</div>
