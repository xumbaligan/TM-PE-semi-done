@page
@model TM_PE.Pages.FieldTechnician.SelectModel

@{
    ViewData["Title"] = "Field Technician";
    Layout = "_FieldTechnicianLayout";
}

<div class="container mt-4" style="max-width: 480px;">
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <h3 class="fw-bold">Field Technician</h3>
            <p class="text-muted">Select your name to view your assigned job orders.</p>

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <form method="post">
                <div class="mb-3">
                    <label class="form-label fw-semibold" for="employeeDropdownBtn">Your Name</label>
                    <div class="dropdown">
                        <button type="button" class="btn status-dropdown-btn dropdown-toggle w-100" id="employeeDropdownBtn"
                                data-bs-toggle="dropdown" aria-expanded="false">
                            Select your name
                        </button>
                        <ul class="dropdown-menu status-dropdown-menu w-100" aria-labelledby="employeeDropdownBtn">
                            <li><a class="dropdown-item active" href="#" data-value="">Select your name</a></li>
                            @foreach (var emp in Model.FieldTechnicians)
                            {
                                <li><a class="dropdown-item" href="#" data-value="@emp.EmployeeId">@emp.FullName</a></li>
                            }
                        </ul>
                    </div>
                    <input type="hidden" name="employeeId" id="employeeSelect" value="" />
                    @if (!Model.FieldTechnicians.Any())
                    {
                        <div class="form-text text-warning">No active Field Technician employees found.</div>
                    }
                </div>

                <button type="submit" class="btn btn-navy w-100">Continue</button>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/status-dropdown.js"></script>
    <script>
        wireStatusDropdown('employeeDropdownBtn', document.getElementById('employeeSelect'));
    </script>
}
