@page
@model TM_PE.Pages.Manager.OfficeTask.IndexModel
@{
    ViewData["Title"] = "Tasks";
    Layout = "_Layout";
}
<div class="mb-3">
    <h1 class="tf-page-title mb-1">Task Assignments</h1>
    <p class="tf-page-sub mb-0">Office task assignments and progress tracking.</p>
</div>
<hr class="page-divider" />

<form method="get" class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <div class="search-input-group flex-grow-1" style="max-width:480px;">
        <i class="bi bi-search"></i>
        <input name="search" id="liveSearch" value="@Model.Search" placeholder="Search by employee, task #, or task name..." />
    </div>
    @{
        var statusOptions = new[] { "Pending", "In Progress", "Completed", "Completed Late", "Overdue" };
    }
    <div class="dropdown" style="max-width:220px;">
        <button type="button" class="btn status-dropdown-btn dropdown-toggle w-100" id="statusDropdownBtn"
                data-bs-toggle="dropdown" aria-expanded="false">
            @(string.IsNullOrEmpty(Model.StatusFilter) ? "All Statuses" : Model.StatusFilter)
        </button>
        <ul class="dropdown-menu status-dropdown-menu w-100" aria-labelledby="statusDropdownBtn">
            <li><a class="dropdown-item @(string.IsNullOrEmpty(Model.StatusFilter) ? "active" : "")" href="#" data-value="">All Statuses</a></li>
            @foreach (var s in statusOptions)
            {
                <li><a class="dropdown-item @(Model.StatusFilter == s ? "active" : "")" href="#" data-value="@s">@s</a></li>
            }
        </ul>
    </div>
    <input type="hidden" name="status" id="liveStatus" value="@Model.StatusFilter" />
    <a asp-page="Create" class="btn btn-navy ms-auto">
        <i class="bi bi-plus-lg"></i> Create New Task
    </a>
    @if (!string.IsNullOrEmpty(Model.ActivityFilter))
    {
        <input type="hidden" name="activity" value="@Model.ActivityFilter" />
    }
</form>

@if (Model.ActivityFilter == "pending-review")
{
    <div class="alert alert-purple d-flex justify-content-between align-items-center py-2">
        <span>Showing tasks with at least one activity awaiting review.</span>
        <a asp-page="./Index" asp-route-search="@Model.Search" asp-route-status="@Model.StatusFilter" class="small">Clear filter</a>
    </div>
}
else if (Model.ActivityFilter == "rejected")
{
    <div class="alert alert-purple d-flex justify-content-between align-items-center py-2">
        <span>Showing tasks with at least one rejected activity awaiting resubmission.</span>
        <a asp-page="./Index" asp-route-search="@Model.Search" asp-route-status="@Model.StatusFilter" class="small">Clear filter</a>
    </div>
}

<div class="table-responsive wlm-card tf-cardify">
    <table class="table align-middle table-hover wlm-table wlm-table-fixed mb-0 tf-mc-table">
        <thead>
            <tr>
                <th style="width:8%">Task #</th>
                <th style="width:20%">Task</th>
                <th style="width:15%">Assignees</th>
                <th style="width:9%">Activities</th>
                <th style="width:11%">Status</th>
                <th style="width:17%">Progress</th>
                <th style="width:9%">Due</th>
                <th class="text-end" style="width:11%">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.OfficeTask.Any())
            {
                <tr id="emptyRow" class="tf-mc-empty">
                    <td colspan="8" class="text-center text-muted py-4">No tasks found</td>
                </tr>
            }
            else
            {
                <tr id="emptyRow" class="tf-mc-empty" style="display:none;">
                    <td colspan="8" class="text-center text-muted py-4">No tasks found</td>
                </tr>
            }
            @foreach (var item in Model.OfficeTask)
            {
                var assigneeNames = string.Join(" ", item.Assignments?.Where(a => a.Employee != null).Select(a => a.Employee!.FullName.ToLower()) ?? Enumerable.Empty<string>());
                <tr data-employee="@assigneeNames"
                    data-taskid="@item.TaskNumber.ToLower()"
                    data-taskname="@item.TaskName.ToLower()"
                    data-status="@item.DisplayStatus.ToLower()">
                    <td class="text-muted tf-mc-sub">
                        @item.TaskNumber
                    </td>

                    <td class="tf-mc-through">
                        <div class="fw-semibold tf-mc-title">@item.TaskName</div>
                        @if (!string.IsNullOrWhiteSpace(item.Description))
                        {
                            <div class="text-muted small tf-mc-hide">@item.Description</div>
                        }
                    </td>

                    <td class="tf-mc-hide">
                        @if (item.Assignments != null && item.Assignments.Any())
                        {
                    @string.Join(", ", item.Assignments
                                        .Where(a => a.Employee != null)
                                        .Select(a => $"{a.Employee!.FullName}"))
                                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>

                    <td class="tf-mc-hide">
                        <span class="fw-semibold" style="color:#020236;">
                            @(item.Activities?.Count(a => a.Status == "Approved") ?? 0)/@(item.Activities?.Count ?? 0)
                        </span>
                    </td>

                    <td class="tf-mc-badge">
                        @{
                            var badgeClass = item.DisplayStatus switch
                            {
                                "Completed" => "bg-success-subtle text-success",
                                "Completed Late" => "bg-warning-subtle text-warning-emphasis",
                                "In Progress" => "bg-info-subtle text-info",
                                "Overdue" => "bg-danger-subtle text-danger",
                                _ => "bg-secondary-subtle text-secondary"
                            };
                        }
                        <span class="status-badge @badgeClass">
                            @item.DisplayStatus
                        </span>
                    </td>

                    <td class="tf-mc-hide">
                        <div class="d-flex align-items-center gap-2">
                            <div class="progress flex-grow-1" style="height:6px;">
                                <div class="progress-bar progress-bar-brand" role="progressbar"
                                     style="width:@(item.Progress)%;"
                                     aria-valuenow="@item.Progress"
                                     aria-valuemin="0"
                                     aria-valuemax="100">
                                </div>
                            </div>
                            <span class="text-muted small">@item.Progress%</span>
                        </div>
                    </td>

                    <td class="text-muted tf-mc-hide">
                        @item.DueDate.ToString("M/d/yyyy")
                    </td>

                    <td class="text-end tf-mc-actions">
                        <button type="button" class="btn btn-sm btn-outline-navy" title="View"
                                data-bs-toggle="modal" data-bs-target="#viewModal-@item.OfficeTaskID">
                            <i class="bi bi-eye"></i>
                        </button>
                        @if (item.Status != "Completed")
                        {
                            <a asp-page="./Edit" asp-route-id="@item.OfficeTaskID"
                               class="btn btn-sm btn-outline-navy" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                        }
                        @*  <form method="post" asp-page-handler="Delete" asp-route-id="@item.OfficeTaskID"
                                  class="d-inline"
                                  onsubmit="return confirm('Delete this task? This cannot be undone.');">
                                <button type="submit" class="btn btn-sm btn-link text-danger p-1" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form> *@
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@* ===================== VIEW MODALS ===================== *@
@* Placed outside the <table> to keep markup valid; one modal per task, populated server-side. *@
@foreach (var item in Model.OfficeTask)
{
    var modalBadgeClass = item.DisplayStatus switch
    {
        "Completed" => "vm-status-success",
        "Completed Late" => "vm-status-warning",
        "In Progress" => "vm-status-info",
        "Overdue" => "vm-status-danger",
        _ => "vm-status-pending"
    };

    var approvedCount = item.Activities?.Count(a => a.Status == "Approved") ?? 0;
    var totalCount = item.Activities?.Count ?? 0;

    <div class="modal fade" id="viewModal-@item.OfficeTaskID" tabindex="-1"
         aria-labelledby="viewModalLabel-@item.OfficeTaskID" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable modal-dialog-centered">
            <div class="modal-content vm-content">

                <div class="modal-header vm-header">
                    <div class="vm-header-icon"><i class="bi bi-clipboard-check"></i></div>
                    <div class="flex-grow-1 overflow-hidden">
                        <div class="vm-title" id="viewModalLabel-@item.OfficeTaskID">@item.TaskName</div>
                        <div class="vm-subtitle">@item.TaskNumber</div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <hr class="vm-header-rule" />

                <div class="modal-body vm-body">

                    @* Status / Progress / Assigned By, then the three dates. *@
                    <div class="vm-card mb-3">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="vm-label">Status</div>
                                <span class="vm-status @modalBadgeClass">@item.DisplayStatus</span>
                            </div>
                            <div class="col-md-4 vm-col-divider">
                                <div class="vm-label">Progress</div>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height:8px; min-width:80px;">
                                        <div class="progress-bar progress-bar-brand" role="progressbar"
                                             style="width:@(item.Progress)%;"
                                             aria-valuenow="@item.Progress"
                                             aria-valuemin="0"
                                             aria-valuemax="100">
                                        </div>
                                    </div>
                                    <span class="vm-value">@item.Progress%</span>
                                </div>
                            </div>
                            <div class="col-md-4 vm-col-divider">
                                <div class="vm-label">Assigned By</div>
                                <div class="vm-value">
                                    <i class="bi bi-person-circle"></i>
                                    @(item.AssignedByEmployee?.FullName ?? "—")
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="vm-label">Date Created</div>
                                <div class="vm-value">
                                    <i class="bi bi-calendar3"></i>
                                    @item.DateCreated.ToString("M/d/yyyy")
                                </div>
                            </div>
                            <div class="col-md-4 vm-col-divider">
                                <div class="vm-label">Due Date</div>
                                <div class="vm-value">
                                    <i class="bi bi-calendar-event"></i>
                                    @item.DueDate.ToString("M/d/yyyy")
                                </div>
                            </div>
                            <div class="col-md-4 vm-col-divider">
                                <div class="vm-label">Date Completed</div>
                                <div class="vm-value">
                                    <i class="bi bi-calendar-check"></i>
                                    @(item.DateCompleted?.ToString("M/d/yyyy") ?? "—/—/—")
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(item.Description))
                    {
                        <div class="vm-card mb-3">
                            <div class="vm-card-label mb-2">Description</div>
                            <div class="vm-text">@item.Description</div>
                        </div>
                    }

                    <div class="vm-card mb-3">
                        <div class="vm-card-label mb-2">Assignee's</div>
                        @if (item.Assignments != null && item.Assignments.Any(a => a.Employee != null))
                        {
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var a in item.Assignments.Where(a => a.Employee != null))
                                {
                                    <span class="vm-pill">@a.Employee!.FullName</span>
                                }
                            </div>
                        }
                        else
                        {
                            <span class="tf-empty-msg">No assignees</span>
                        }
                    </div>

                    <div class="vm-card">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <span class="vm-card-label">Activities</span>
                            <span class="vm-count-badge">@approvedCount/@totalCount</span>
                        </div>

                        @if (item.Activities != null && item.Activities.Any())
                        {
                            <div class="table-responsive">
                                <table class="table vm-table wlm-table-fixed align-middle">
                                    <thead>
                                        <tr>
                                            <th style="width:22%">Activity</th>
                                            <th style="width:18%">Status</th>
                                            <th style="width:40%">Feedback</th>
                                            <th style="width:20%">Created</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            var activityIndex = 0;
                                        }
                                        @foreach (var activity in item.Activities)
                                        {
                                            activityIndex++;
                                            var activityBadgeClass = activity.Status switch
                                            {
                                                "Approved" => "vm-status-success",
                                                "Revised" => "vm-status-info",
                                                _ => "vm-status-pending"
                                            };
                                            <tr>
                                                <td>
                                                    <div class="d-flex align-items-center gap-2">
                                                        <span class="vm-num-badge">@activityIndex</span>
                                                        <span class="fw-bold">@activity.ActivityName</span>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="vm-status @activityBadgeClass">@activity.Status</span>
                                                </td>
                                                <td class="text-muted">
                                                    @if (!string.IsNullOrWhiteSpace(activity.FeedBack))
                                                    {
                                                        @activity.FeedBack
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">—</span>
                                                    }
                                                </td>
                                                <td class="fw-bold">
                                                    @activity.DateCreated.ToString("M/d/yyyy")
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <span class="tf-empty-msg">No activities recorded for this task.</span>
                        }
                    </div>

                </div>

                <div class="modal-footer vm-footer">
                    <button type="button" class="vm-btn-close" data-bs-dismiss="modal">Close</button>
                    <a asp-page="./Details" asp-route-id="@item.OfficeTaskID" class="vm-btn-primary">
                        Open Full Details
                    </a>
                </div>

            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/status-dropdown.js"></script>
    <script>
        const searchInput = document.getElementById('liveSearch');
        const statusInput = document.getElementById('liveStatus');
        const rows = document.querySelectorAll('tbody tr[data-taskid]');

        function filterTable() {
            const searchVal = searchInput.value.toLowerCase().trim();
            const statusVal = statusInput.value.toLowerCase().trim();
            let visibleCount = 0;

            rows.forEach(row => {
                const employee = row.dataset.employee || '';
                const taskId = row.dataset.taskid || '';
                const taskName = row.dataset.taskname || '';
                const status = row.dataset.status || '';

                const matchesSearch = employee.includes(searchVal) || taskId.includes(searchVal) || taskName.includes(searchVal);
                const matchesStatus = statusVal === '' || status === statusVal;

                if (matchesSearch && matchesStatus) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            const emptyRow = document.getElementById('emptyRow');
            if (emptyRow) {
                emptyRow.style.display = visibleCount === 0 ? '' : 'none';
            }

            // Re-paginate against whatever the filter just left visible, so
            // Prev/Next and the page count match the filtered rows instead of
            // the full unfiltered table (and the nav disappears entirely once
            // the filtered set is small enough to fit on one page).
            if (window.TFPagination) window.TFPagination.init(document.querySelector('table.wlm-table'));
        }

        searchInput.addEventListener('input', filterTable);
        wireStatusDropdown('statusDropdownBtn', statusInput, { onChange: filterTable });

        // Apply immediately on load too, so a link that arrives with
        // ?status=... (e.g. from the Dashboard) actually filters the table
        // instead of only pre-selecting the dropdown.
        filterTable();
    </script>
}
