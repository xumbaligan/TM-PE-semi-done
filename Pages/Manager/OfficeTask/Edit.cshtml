@page "{id:int}"
@model TM_PE.Pages.Manager.OfficeTask.EditModel

@{
    ViewData["Title"] = "Edit Task";
    Layout = "_Layout";
}

<div class="mb-3">
    <h1 class="tf-page-title mb-1">Edit Task</h1>
    <p class="tf-page-sub mb-0">
        Update the task details, reassign employees, or adjust its activities.
    </p>
</div>

<form method="post" id="taskForm">

    <partial name="_RestrictionModal" model="(string?)null" />
    <input type="hidden" asp-for="OfficeTask.OfficeTaskID" />

    <!-- Read-only meta strip: task number + date created + assigned by -->
    <div class="tf-meta-card mb-4">
        <div class="d-flex flex-column flex-md-row">

            <div class="tf-meta-item">
                <div class="tf-meta-icon"><i class="bi bi-tag-fill"></i></div>
                <div class="overflow-hidden">
                    <div class="tf-meta-label">Task Number</div>
                    <div class="tf-meta-value">@Model.OfficeTask.TaskNumber</div>
                </div>
            </div>

            <div class="tf-meta-item">
                <div class="tf-meta-icon"><i class="bi bi-calendar3"></i></div>
                <div class="overflow-hidden">
                    <div class="tf-meta-label">Date Created</div>
                    <div class="tf-meta-value">@Model.OfficeTask.DateCreated.ToString("MM/dd/yyyy")</div>
                </div>
            </div>

            <div class="tf-meta-item">
                <div class="tf-meta-icon"><i class="bi bi-person-fill"></i></div>
                <div class="overflow-hidden">
                    <div class="tf-meta-label">Assigned by</div>
                    <div class="tf-meta-value">@(Model.OfficeTask.AssignedByEmployee?.FullName ?? "—")</div>
                </div>
            </div>

        </div>
    </div>

    <!-- Step 1: Task Details -->
    <div class="tf-section mb-4">

        <div class="d-flex align-items-center gap-2 mb-4">
            <div class="tf-step-badge">1</div>
            <div class="tf-section-title">Task Details</div>
        </div>

        <div class="mb-3">
            <label class="tf-label" asp-for="OfficeTask.TaskName">
                Task Name <span class="tf-required">*</span>
            </label>

            <input asp-for="OfficeTask.TaskName"
                   class="form-control"
                   placeholder="e.g. Quarterly inventory audit" />

            <span asp-validation-for="OfficeTask.TaskName" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label class="tf-label" asp-for="OfficeTask.Description">Description</label>

            <textarea asp-for="OfficeTask.Description"
                      rows="4"
                      class="form-control"
                      placeholder="Instructions, objectives, or additional details..."></textarea>

            <span asp-validation-for="OfficeTask.Description" class="text-danger small"></span>
        </div>

        <div class="mb-2" style="max-width:440px;">
            <label class="tf-label" asp-for="OfficeTask.DueDate">
                Due Date <span class="tf-required">*</span>
            </label>

            <input asp-for="OfficeTask.DueDate"
                   type="date"
                   class="form-control" />

            <span asp-validation-for="OfficeTask.DueDate" class="text-danger small"></span>
        </div>

        <div class="tf-hint">
            <i class="bi bi-info-circle"></i>
            <span>
                The final deadline to complete this task. If it isn't finished by this date,
                the system will automatically mark it Overdue.
            </span>
        </div>

        @* Status and Progress were already commented out on this page before the
           restyle - they're recalculated server-side, never edited by hand. *@

    </div>

    <!-- Step 2: Assigned Employees (view only, cannot be added or removed here) -->
    <div class="tf-section mb-4">

        <div class="d-flex align-items-center gap-2 mb-1">
            <div class="tf-step-badge">2</div>
            <div class="tf-section-title">Assigned Employees</div>
        </div>
        <p class="tf-section-sub mb-3">
            Assignees are fixed at creation and can't be added or removed from this page.
        </p>

        @if (Model.OfficeTask.Assignments != null && Model.OfficeTask.Assignments.Any(a => a.Employee != null))
        {
            @foreach (var a in Model.OfficeTask.Assignments.Where(a => a.Employee != null))
            {
                <div class="tf-chip">
                    <span class="text-truncate">@a.Employee!.FullName</span>
                    <input type="hidden" name="SelectedEmployeeIds" value="@a.EmployeeID" />
                </div>
            }
        }
        else
        {
            <span class="tf-empty-msg">No employees assigned yet.</span>
        }

    </div>

    <!-- Step 3: Task Activities (view only, cannot be added or removed here) -->
    <div class="tf-section mb-4">

        <div class="d-flex align-items-center gap-2 mb-3">
            <div class="tf-step-badge">3</div>
            <div class="tf-section-title">Task Activities</div>
        </div>

        @if (Model.OfficeTask.Activities != null && Model.OfficeTask.Activities.Any())
        {
            @foreach (var act in Model.OfficeTask.Activities)
            {
                <div class="tf-chip">
                    <span class="text-truncate">@act.ActivityName</span>
                    <span class="tf-chip-status">@act.Status</span>
                    <input type="hidden" name="KeptActivityIds" value="@act.ActivityID" />
                </div>
            }
        }
        else
        {
            <span class="tf-empty-msg">No activities yet.</span>
        }

    </div>

    <!-- Footer Buttons -->
    <div class="d-flex justify-content-end gap-2">

        <a asp-page="Index" class="tf-btn-cancel">Cancel</a>

        <button type="submit" class="tf-btn-save">Save Changes</button>

    </div>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
