@page "{id:int}"
@model TM_PE.Pages.Manager.PerformanceEvaluation.DetailsModel
@{
    ViewData["Title"] = "Evaluation Details";
    Layout = "_Layout";
    var e = Model.Evaluation;
    var ratingClass = TM_PE.Model.EvaluationScoring.RatingBadgeClass(e.OverallRating);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-clipboard-data"></i> Evaluation Details</h2>
    <div class="d-flex gap-2">
        @if (e.EvaluationStatus == TM_PE.Model.EvaluationStatus.Draft)
        {
            <a class="btn btn-outline-primary" asp-page="Edit" asp-route-id="@e.EvaluationID">
                <i class="bi bi-pencil"></i> Edit
            </a>
        }
        <a class="btn btn-outline-secondary" asp-page="Index"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>

<div class="card p-4 mb-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
            <div class="fs-4 fw-bold">@(e.Employee?.FullName ?? "-")</div>
            <div class="text-muted">@e.Employee?.RoleType</div>
        </div>
        <div class="text-end">
            <div class="d-flex align-items-center gap-2 justify-content-end">
                <partial name="_Stars" model="e.OverallStars" />
                <span class="fs-4 fw-bold">@e.OverallScore.ToString("0.##") / 4</span>
            </div>
            <span class="badge bg-@(ratingClass)-subtle text-@(ratingClass)-emphasis">@e.OverallRating</span>
        </div>
    </div>

    <hr />

    <div class="row g-3">
        <div class="col-sm-3">
            <div class="text-muted small">Evaluation Period</div>
            <div class="fw-semibold">@e.EvaluationPeriod</div>
        </div>
        <div class="col-sm-3">
            <div class="text-muted small">Evaluation Date</div>
            <div class="fw-semibold">@e.EvaluationDate.ToString("MMMM d, yyyy")</div>
        </div>
        <div class="col-sm-3">
            <div class="text-muted small">Evaluated By</div>
            <div class="fw-semibold">@e.EvaluatorName</div>
        </div>
        <div class="col-sm-3">
            <div class="text-muted small">Status</div>
            @if (e.EvaluationStatus == TM_PE.Model.EvaluationStatus.Finalized)
            {
                <span class="badge bg-success-subtle text-success-emphasis">Finalized</span>
            }
            else
            {
                <span class="badge bg-secondary-subtle text-secondary">Draft</span>
            }
        </div>
    </div>
</div>

<div class="card p-4 mb-4">
    <h5 class="mb-3">Criteria Ratings</h5>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr class="text-muted small">
                    <th style="width:32%">Criteria</th>
                    <th style="width:24%">Rating</th>
                    <th style="width:14%">Score</th>
                    <th>Feedback</th>
                </tr>
            </thead>
            <tbody>
                @if (!e.Results.Any())
                {
                    <tr><td colspan="4" class="text-muted">No scored criteria.</td></tr>
                }
                else
                {
                    @foreach (var r in e.Results.OrderByDescending(r => r.Criteria?.Weight ?? 0))
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@(r.Criteria?.CriteriaName ?? "-")</div>
                                <div class="text-muted small">Weight @(r.Criteria?.Weight ?? 0)%</div>
                            </td>
                            <td>
                                <partial name="_Stars" model="r.StarRating" />
                                <div class="text-muted small">@r.StarRating.ToString("0.#") / 4</div>
                            </td>
                            <td>@r.Score.ToString("0.##") / @(r.Criteria?.Weight ?? 0)</td>
                            <td class="text-muted">@(string.IsNullOrEmpty(r.Feedback) ? "-" : r.Feedback)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card p-4">
    <h5 class="mb-3">Feedback</h5>
    <div class="text-muted">@(string.IsNullOrEmpty(e.GeneralFeedback) ? "No feedback recorded." : e.GeneralFeedback)</div>
</div>
