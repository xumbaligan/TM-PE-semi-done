@page "{id:int}"
@model TM_PE.Pages.Manager.PerformanceEvaluation.EditModel
@{
    ViewData["Title"] = "Edit Performance Evaluation";
    Layout = "_Layout";
}

<div class="mb-3">
    <h1 class="tf-page-title mb-1">Edit Performance Evaluation</h1>
    <p class="tf-page-sub mb-0">Update ratings, feedback, or finalize this evaluation</p>
</div>
<hr class="page-divider" />

<form method="post" id="evalForm">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <input type="hidden" asp-for="Evaluation.EvaluationID" />

    <div class="row g-4">
        <div class="col-lg-8">

            <div class="tf-section mb-4">
                <div class="tf-section-title mb-3">Evaluation Details</div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="tf-label">Employee</label>
                        <input class="form-control" value="@(Model.Employee?.FullName) (@Model.Employee?.RoleType)" disabled />
                        <div class="tf-form-hint">The employee on an evaluation can't be changed — create a new evaluation instead.</div>
                    </div>
                    <div class="col-md-6">
                        <label class="tf-label">Evaluator</label>
                        <input class="form-control" value="@Model.Evaluation.EvaluatorName" disabled />
                        <div class="tf-form-hint">Set automatically when this evaluation was created — not editable.</div>
                    </div>
                    <div class="col-md-6">
                        <label class="tf-label">Evaluation Period</label>
                        <input class="form-control" value="@Model.Evaluation.EvaluationPeriod" disabled />
                    </div>
                    <div class="col-md-6">
                        <label class="tf-label">Evaluation Date <span class="tf-required">*</span></label>
                        <input asp-for="Evaluation.EvaluationDate" type="date" class="form-control"
                               value="@Model.Evaluation.EvaluationDate.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="Evaluation.EvaluationDate" class="text-danger small"></span>
                        <div class="tf-form-hint">Also used as the appraisal date.</div>
                    </div>
                </div>
            </div>

            <div class="tf-section mb-4">
                <div class="tf-section-title mb-1">@Model.Employee?.RoleType Criteria</div>
                <p class="tf-section-sub mb-3">Rate each criterion from 0.5 to 4 stars &mdash; click the left half of a star for a half rating. Click the same rating again to clear it.</p>
                <div class="eval-criteria-table">
                    <partial name="_CriteriaStarRows" model="Model.Rows" />
                </div>
            </div>

            <div class="tf-section mb-4">
                <div class="tf-section-title mb-1">Feedback</div>
                <p class="tf-section-sub mb-3">Summary of the employee's overall performance and areas for improvement.</p>
                <textarea asp-for="Evaluation.GeneralFeedback" class="form-control eval-feedback" rows="5" maxlength="1000"
                          placeholder="Overall feedback for this evaluation period..."></textarea>
                <div class="tf-form-hint">Covers both the evaluation and the appraisal decision.</div>
            </div>

        </div>

        <div class="col-lg-4">
            <div class="sticky-top" style="top:1rem">

                @* ===================== Employee performance snapshot ===================== *@
                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <div class="eval-stat eval-stat-primary d-flex align-items-start gap-2">
                            <div class="stat-icon icon-palette-primary"><i class="bi bi-check2-circle"></i></div>
                            <div class="overflow-hidden">
                                <div class="stat-label">Completed Job/Task</div>
                                <div class="stat-value">@Model.Stats.CompletedJobsTasks</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="eval-stat eval-stat-success d-flex align-items-start gap-2">
                            <div class="stat-icon icon-palette-success"><i class="bi bi-clock-history"></i></div>
                            <div class="overflow-hidden">
                                <div class="stat-label">On-time Rate</div>
                                <div class="stat-value">@Model.Stats.OnTimeRate.ToString("0")%</div>
                            </div>
                        </div>
                    </div>
                    @* Office Staff office tasks never use the Rescheduled/Cancelled job ticket
                       statuses, so those tiles would always read 0 for them - show the
                       equivalents that actually apply instead. *@
                    @if (Model.Employee?.RoleType == TM_PE.Model.RoleType.OfficeStaff)
                    {
                        <div class="col-6">
                            <div class="eval-stat eval-stat-danger d-flex align-items-start gap-2">
                                <div class="stat-icon icon-palette-danger"><i class="bi bi-hand-thumbs-down"></i></div>
                                <div class="overflow-hidden">
                                    <div class="stat-label">Rejected Activities</div>
                                    <div class="stat-value">@Model.Stats.RejectedActivities</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="eval-stat eval-stat-warning d-flex align-items-start gap-2">
                                <div class="stat-icon icon-palette-warning"><i class="bi bi-exclamation-triangle"></i></div>
                                <div class="overflow-hidden">
                                    <div class="stat-label">Overdue Task</div>
                                    <div class="stat-value">@Model.Stats.OverdueTasks</div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="col-6">
                            <div class="eval-stat eval-stat-warning d-flex align-items-start gap-2">
                                <div class="stat-icon icon-palette-warning"><i class="bi bi-arrow-repeat"></i></div>
                                <div class="overflow-hidden">
                                    <div class="stat-label">Rescheduled</div>
                                    <div class="stat-value">@Model.Stats.Rescheduled</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="eval-stat eval-stat-danger d-flex align-items-start gap-2">
                                <div class="stat-icon icon-palette-danger"><i class="bi bi-x-circle"></i></div>
                                <div class="overflow-hidden">
                                    <div class="stat-label">Cancelled</div>
                                    <div class="stat-value">@Model.Stats.Cancelled</div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="eval-score-card mb-3">
                    <div class="eval-score-label">Overall Score (preview)</div>
                    <div class="eval-score-value" id="overallScorePreview">@Model.Evaluation.OverallScore.ToString("0.#")</div>
                    <div class="eval-score-out-of">out of 4</div>
                    <div class="mt-2 d-flex align-items-center justify-content-center gap-2 flex-wrap">
                        <span id="overallStarsPreview"></span>
                        <span class="vm-status vm-status-pending" id="overallRatingPreview">@Model.Evaluation.OverallRating</span>
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="tf-btn-cancel" asp-page-handler="SaveDraft" asp-route-id="@Model.Evaluation.EvaluationID">
                        Save as Draft
                    </button>
                    <button type="submit" class="tf-btn-save" asp-page-handler="Finalize" asp-route-id="@Model.Evaluation.EvaluationID"
                            onclick="return confirm('Finalize this evaluation? Once finalized it can no longer be edited.');">
                        Finalize Evaluation
                    </button>
                </div>
                <div class="tf-form-hint text-center mt-2">A draft can still be edited later; finalizing locks it.</div>

            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script src="~/js/star-rating.js" asp-append-version="true"></script>
    <script>
        (function () {
            const scorePreview = document.getElementById('overallScorePreview');
            const ratingPreview = document.getElementById('overallRatingPreview');
            const starsPreview = document.getElementById('overallStarsPreview');

            const bands = [[3.6, 'Excellent'], [3.2, 'Very Good'], [2.8, 'Good'], [2.4, 'Needs Improvement'], [0, 'Poor']];

            function ratingFor(score) {
                for (const [min, label] of bands) { if (score >= min) return label; }
                return 'Poor';
            }

            function recalcPreview() {
                let total = 0;
                document.querySelectorAll('.star-value-input:not(:disabled)').forEach(input => {
                    const weight = parseFloat(input.dataset.weight || '0');
                    const stars = window.StarRating.snap(input.value || '0');
                    total += weight / 100 * stars;
                });
                scorePreview.textContent = total.toFixed(1);
                ratingPreview.textContent = ratingFor(total);
                starsPreview.innerHTML = window.StarRating.render(total);
            }

            document.addEventListener('change', function (e) {
                if (e.target.classList.contains('star-value-input')) recalcPreview();
            });

            window.StarRating.initAll(document);
            recalcPreview();
        })();
    </script>
}
