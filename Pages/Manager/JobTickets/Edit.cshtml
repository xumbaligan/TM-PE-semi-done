@page "{id:int}"
@model TM_PE.Pages.Manager.JobTickets.EditModel

@{
    ViewData["Title"] = "Edit Job Ticket";
    Layout = "_Layout";

    string FiberPlanDisplay(string name) =>
        System.Text.RegularExpressions.Regex.IsMatch(name, @"^\d+$") ? $"₱{name} / month" : name;
}

<div class="mb-3">
    <h1 class="tf-page-title mb-1">Edit Job Ticket</h1>
    <p class="tf-page-sub mb-0">
        Update the job details below. Assigned field technicians can't be added or removed here.
    </p>
</div>

<form method="post" id="ticketForm">

    <partial name="_RestrictionModal" model="(string?)null" />
    <input type="hidden" asp-for="JobTicket.JobTicketID" />

    <!-- Read-only meta strip: ticket number + date created + assigned by -->
    <div class="tf-meta-card mb-4">
        <div class="d-flex flex-column flex-md-row">

            <div class="tf-meta-item">
                <div class="tf-meta-icon"><i class="bi bi-tag-fill"></i></div>
                <div class="overflow-hidden">
                    <div class="tf-meta-label">Ticket Number</div>
                    <div class="tf-meta-value">@Model.JobTicket.TicketNumber</div>
                </div>
            </div>

            <div class="tf-meta-item">
                <div class="tf-meta-icon"><i class="bi bi-calendar3"></i></div>
                <div class="overflow-hidden">
                    <div class="tf-meta-label">Date Created</div>
                    <div class="tf-meta-value">@Model.JobTicket.DateCreated.ToString("MM/dd/yyyy")</div>
                </div>
            </div>

            <div class="tf-meta-item">
                <div class="tf-meta-icon"><i class="bi bi-person-fill"></i></div>
                <div class="overflow-hidden">
                    <div class="tf-meta-label">Assigned by</div>
                    <div class="tf-meta-value">@(Model.JobTicket.AssignedByEmployee?.FullName ?? "—")</div>
                </div>
            </div>

        </div>
    </div>

    <!-- Step 1: Job Details -->
    <div class="tf-section mb-4">

        <div class="d-flex align-items-center gap-2 mb-4">
            <div class="tf-step-badge">1</div>
            <div class="tf-section-title">Job Details</div>
        </div>

        <!-- Job Type -->
        <div class="mb-3">
            <label class="tf-label" asp-for="JobTicket.JobType">
                Job Type <span class="tf-required">*</span>
            </label>

            <div class="dropdown">
                <button type="button" class="btn status-dropdown-btn dropdown-toggle w-100" id="jobTypeDropdownBtn"
                        data-bs-toggle="dropdown" aria-expanded="false">
                    @Model.JobTicket.JobType
                </button>
                <ul class="dropdown-menu status-dropdown-menu w-100" aria-labelledby="jobTypeDropdownBtn">
                    @foreach (var type in Model.JobTypeOptions)
                    {
                        <li><a class="dropdown-item @(type == Model.JobTicket.JobType ? "active" : "")" href="#" data-value="@type">@type</a></li>
                    }
                </ul>
            </div>
            <input type="hidden" asp-for="JobTicket.JobType" id="jobTypeSelect" />

            <span asp-validation-for="JobTicket.JobType" class="text-danger small"></span>
        </div>

        <!-- Client Info (auto-cleared/hidden when Job Type = Maintenance) -->
        <div class="row g-3 mb-3" id="clientInfoGroup">
            <div class="col-md-4">
                <label class="tf-label" asp-for="JobTicket.ClientFullName">
                    Full Name (Client) <span class="tf-required">*</span>
                </label>
                <input asp-for="JobTicket.ClientFullName" id="clientFullNameInput" class="form-control" />
                <span asp-validation-for="JobTicket.ClientFullName" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label class="tf-label" asp-for="JobTicket.PrimaryNumber">
                    Primary Number <span class="tf-required">*</span>
                </label>
                <input asp-for="JobTicket.PrimaryNumber" id="primaryNumberInput" class="form-control" inputmode="numeric" maxlength="11" />
                <span asp-validation-for="JobTicket.PrimaryNumber" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label class="tf-label" asp-for="JobTicket.SecondaryNumber">Secondary Number</label>
                <input asp-for="JobTicket.SecondaryNumber" id="secondaryNumberInput" class="form-control" inputmode="numeric" maxlength="11" />
                <span asp-validation-for="JobTicket.SecondaryNumber" class="text-danger small"></span>
            </div>
        </div>

        <!-- Fiber Plan (Installation) / Description (Repair, Inspection, Maintenance) + Date -->
        <div class="row g-3 mb-3">
            <div class="col-md-6" id="fiberPlanGroup">
                <label class="tf-label" asp-for="JobTicket.FiberPlan">
                    Fiber Plan <span class="tf-required">*</span>
                </label>
                @{
                    var currentPlanOffered = Model.FiberPlanOptions.Any(p => p.PlanName == Model.JobTicket.FiberPlan);
                    var currentPlanLabel = string.IsNullOrEmpty(Model.JobTicket.FiberPlan)
                        ? "Select a plan"
                        : FiberPlanDisplay(Model.JobTicket.FiberPlan) + (currentPlanOffered ? "" : " (no longer offered)");
                }
                <div class="dropdown">
                    <button type="button" class="btn status-dropdown-btn dropdown-toggle w-100" id="fiberPlanDropdownBtn"
                            data-bs-toggle="dropdown" aria-expanded="false">
                        @currentPlanLabel
                    </button>
                    <ul class="dropdown-menu status-dropdown-menu w-100" id="fiberPlanDropdownMenu" aria-labelledby="fiberPlanDropdownBtn">
                        <li><a class="dropdown-item @(string.IsNullOrEmpty(Model.JobTicket.FiberPlan) ? "active" : "")" href="#" data-value="">Select a plan</a></li>
                        @foreach (var plan in Model.FiberPlanOptions)
                        {
                            <li><a class="dropdown-item @(plan.PlanName == Model.JobTicket.FiberPlan ? "active" : "")" href="#" data-value="@plan.PlanName">@FiberPlanDisplay(plan.PlanName)</a></li>
                        }
                        @if (!string.IsNullOrEmpty(Model.JobTicket.FiberPlan) && !currentPlanOffered)
                        {
                            <!-- This ticket's plan was later removed from the manager-maintained list;
                                 still show it here so the current value isn't silently lost. -->
                            <li><a class="dropdown-item active" href="#" data-value="@Model.JobTicket.FiberPlan">@FiberPlanDisplay(Model.JobTicket.FiberPlan) (no longer offered)</a></li>
                        }
                    </ul>
                </div>
                <input type="hidden" asp-for="JobTicket.FiberPlan" id="fiberPlanSelect" />
                <span asp-validation-for="JobTicket.FiberPlan" class="text-danger small"></span>
            </div>

            <div class="col-md-6 d-none" id="descriptionGroup">
                <label class="tf-label" asp-for="JobTicket.Description">
                    Description <span class="tf-required">*</span>
                </label>
                <textarea asp-for="JobTicket.Description" id="descriptionInput" class="form-control" rows="1" maxlength="500"></textarea>
                <span asp-validation-for="JobTicket.Description" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label class="tf-label" id="serviceDateLabel" asp-for="JobTicket.ServiceDate">
                    Date of Installation <span class="tf-required">*</span>
                </label>
                <input asp-for="JobTicket.ServiceDate" type="date" id="serviceDateInput"
                       value="@Model.JobTicket.ServiceDate.ToString("yyyy-MM-dd")"
                       class="form-control" />
                <input type="hidden" id="originalServiceDate" value="@Model.OriginalServiceDate.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="JobTicket.ServiceDate" class="text-danger small"></span>
            </div>
        </div>

        <div class="mb-2" style="max-width:440px;">
            <label class="tf-label" asp-for="JobTicket.DateOfCompletion">
                Due Date <span class="tf-required">*</span>
            </label>
            <input asp-for="JobTicket.DateOfCompletion" type="date" id="dateOfCompletionInput"
                   value="@(Model.JobTicket.DateOfCompletion?.ToString("yyyy-MM-dd"))"
                   class="form-control" />
            <span asp-validation-for="JobTicket.DateOfCompletion" class="text-danger small"></span>
        </div>

        <div class="tf-hint">
            <i class="bi bi-info-circle"></i>
            <span>
                The deadline for this job to be finished. If this date passes and the job
                still isn't done, it's automatically marked Overdue.
            </span>
        </div>

    </div>

    @if (Model.JobTicket.Status == "Reschedule Request")
    {
        <div class="alert alert-warning">
            <i class="bi bi-hourglass-split me-1"></i>
            Changing the date will mark this job order as
            <strong>Rescheduled</strong> and start a new technician cycle.
            The assigned field technician's current remarks and photos/files
            will be archived so they can start fresh for the new date.
        </div>
    }

    <!-- Step 2: Job Location -->
    <div class="tf-section mb-4">

        <div class="d-flex align-items-center gap-2 mb-4">
            <div class="tf-step-badge">2</div>
            <div class="tf-section-title">Job Location <span class="tf-required">*</span></div>
        </div>

        <div class="mb-3">
            <label class="tf-label" asp-for="JobTicket.LocationAddress">Address</label>
            <input asp-for="JobTicket.LocationAddress" id="locationAddressInput" class="form-control" placeholder="Enter the job site address" />
            <span asp-validation-for="JobTicket.LocationAddress" class="text-danger small"></span>
        </div>

        <div>
            <label class="tf-label" asp-for="JobTicket.NearestLandmark">Nearest Landmark</label>
            <input asp-for="JobTicket.NearestLandmark" id="nearestLandmarkInput" class="form-control" placeholder="e.g. Near the barangay hall" />
            <span asp-validation-for="JobTicket.NearestLandmark" class="text-danger small"></span>
        </div>

    </div>

    <!-- Step 3: Assignees (fixed team; leader can be changed only while Pending) -->
    <div class="tf-section mb-4">

        <div class="d-flex align-items-center gap-2 mb-1">
            <div class="tf-step-badge">3</div>
            <div class="tf-section-title">Assigned Field Technicians</div>
        </div>

        @if (Model.JobTicket.Assignments != null && Model.JobTicket.Assignments.Any())
        {
            @if (Model.JobTicket.CanReassignLeader)
            {
                <p class="tf-section-sub mb-3">
                    Choose who leads this job order. The assigned team itself can't be
                    added to or removed from here &mdash; only who leads them.
                </p>
                <div id="assignedEmployees" class="d-flex flex-column">
                    @foreach (var a in Model.JobTicket.Assignments.Where(a => a.Employee != null))
                    {
                        <div class="tf-chip" data-employee-id="@a.EmployeeID">
                            <input class="form-check-input leaderRadio flex-shrink-0 mt-0" type="radio"
                                   name="LeaderEmployeeId" id="leaderRadio-@a.EmployeeID"
                                   value="@a.EmployeeID" title="Set as leader"
                                   checked="@(Model.LeaderEmployeeId == a.EmployeeID)" />
                            <span class="flex-grow-1" id="empName-@a.EmployeeID">
                                @a.Employee!.FullName
                                <span class="tf-leader-badge ms-2 leaderTag @(Model.LeaderEmployeeId == a.EmployeeID ? "" : "d-none")">Leader</span>
                            </span>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="tf-section-sub mb-3">
                    The leader can only be changed while this job order is Pending or In Progress.
                </p>
                @foreach (var a in Model.JobTicket.Assignments.Where(a => a.Employee != null))
                {
                    <div class="tf-chip">
                        <span class="flex-grow-1 text-truncate">@a.Employee!.FullName</span>
                        @if (a.IsLeader)
                        {
                            <span class="tf-leader-badge">Leader</span>
                        }
                    </div>
                }
            }
        }
        else
        {
            <span class="tf-empty-msg">No assignees</span>
        }

        <div class="mt-4">
            <label class="tf-label">Leader Remarks</label>

            <textarea class="form-control" rows="3" readonly>@Model.JobTicket.Remarks</textarea>

            <div class="tf-hint mt-2">
                <i class="bi bi-info-circle"></i>
                <span>
                    Remarks submitted by the field technician leader. Assignees are fixed at
                    creation and can't be added or removed from this page.
                </span>
            </div>
        </div>

    </div>

    <!-- Footer Buttons -->
    <div class="d-flex justify-content-end gap-2">
        <a asp-page="Index" class="tf-btn-cancel">Cancel</a>
        <button type="submit" class="tf-btn-save">Save Changes</button>
    </div>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/address-autocomplete.js"></script>
    <script src="~/js/status-dropdown.js"></script>
    <script>
        (function () {
            // ---------------- ADDRESS AUTOCOMPLETE ----------------
            // Biased toward Cebu/Philippines; users can still search anywhere.
            // initAddressAutocomplete(document.getElementById('locationAddressInput'), { lat: 10.3157, lon: 123.8854 });
            // initAddressAutocomplete(document.getElementById('nearestLandmarkInput'), { lat: 10.3157, lon: 123.8854 });

            // ---------------- JOB TYPE TOGGLE ----------------
            const jobTypeSelect = document.getElementById('jobTypeSelect');
            const fiberPlanGroup = document.getElementById('fiberPlanGroup');
            const fiberPlanSelect = document.getElementById('fiberPlanSelect');
            const descriptionGroup = document.getElementById('descriptionGroup');
            const descriptionInput = document.getElementById('descriptionInput');
            const serviceDateLabel = document.getElementById('serviceDateLabel');
            const serviceDateInput = document.getElementById('serviceDateInput');

            // Client Info (Full Name / Primary / Secondary) — only collected for
            // non-Maintenance jobs. Switching to Maintenance clears whatever was typed;
            // switching away from Maintenance brings the fields back (empty, to be filled in).
            const clientInfoGroup = document.getElementById('clientInfoGroup');
            const clientFullNameInput = document.getElementById('clientFullNameInput');
            const primaryNumberInput = document.getElementById('primaryNumberInput');
            const secondaryNumberInput = document.getElementById('secondaryNumberInput');

            // Philippine mobile numbers only: digits only, capped at 11
            // (e.g. 09171234567), matching JobTicket.PrimaryNumber/SecondaryNumber.
            function restrictToPhMobile(input) {
                input.addEventListener('input', function () {
                    input.value = input.value.replace(/\D/g, '').slice(0, 11);
                });
            }
            restrictToPhMobile(primaryNumberInput);
            restrictToPhMobile(secondaryNumberInput);

            function applyClientInfoVisibility(type) {
                if (type === 'Maintenance') {
                    clientInfoGroup.classList.add('d-none');
                    clientFullNameInput.value = '';
                    primaryNumberInput.value = '';
                    secondaryNumberInput.value = '';
                    clientFullNameInput.removeAttribute('required');
                    primaryNumberInput.removeAttribute('required');
                } else {
                    clientInfoGroup.classList.remove('d-none');
                    clientFullNameInput.setAttribute('required', 'required');
                    primaryNumberInput.setAttribute('required', 'required');
                }
            }

              function applyJobType() {
                const type = jobTypeSelect.value;
                if (type === 'Installation') {
                    fiberPlanGroup.classList.remove('d-none');
                    descriptionGroup.classList.add('d-none');
                    fiberPlanSelect.setAttribute('required', 'required');
                    descriptionInput.removeAttribute('required');
                    serviceDateLabel.innerHTML = 'Date of Installation <span class="text-danger">*</span>';
                } else if (type === 'Repair') {
                    fiberPlanGroup.classList.add('d-none');
                    descriptionGroup.classList.remove('d-none');
                    fiberPlanSelect.removeAttribute('required');
                    descriptionInput.setAttribute('required', 'required');
                    serviceDateLabel.innerHTML = 'Date of Repair <span class="text-danger">*</span>';
                } else if (type === 'Inspection') {
                    fiberPlanGroup.classList.add('d-none');
                    descriptionGroup.classList.remove('d-none');
                    fiberPlanSelect.removeAttribute('required');
                    descriptionInput.setAttribute('required', 'required');
                    serviceDateLabel.innerHTML = 'Date of Inspection <span class="text-danger">*</span>';
                } else if (type === 'Maintenance') {
                    fiberPlanGroup.classList.add('d-none');
                    descriptionGroup.classList.remove('d-none');
                    fiberPlanSelect.removeAttribute('required');
                    descriptionInput.setAttribute('required', 'required');
                    serviceDateLabel.innerHTML = 'Date of Maintenance <span class="text-danger">*</span>';
                } else {
                    fiberPlanGroup.classList.remove('d-none');
                    descriptionGroup.classList.add('d-none');
                    serviceDateLabel.innerHTML = 'Date <span class="text-danger">*</span>';
                }
                applyClientInfoVisibility(type);
            }

            wireStatusDropdown('jobTypeDropdownBtn', jobTypeSelect, { onChange: applyJobType });
            wireStatusDropdown('fiberPlanDropdownBtn', fiberPlanSelect);
            applyJobType();

            // ---------------- SERVICE DATE (reschedule) ----------------
            // A reschedule can never move into the past - but an existing
            // ticket's ServiceDate can already be in the past on load (e.g.
            // still Pending days after the originally scheduled date), and
            // that stored value must still submit cleanly if left untouched.
            // So the "no past dates" floor only kicks in once the manager
            // actually changes the field, not from a static min at load
            // (which would make the browser reject an untouched, already-past
            // date on submit).
            const todayStr = new Date().toISOString().slice(0, 10);
            serviceDateInput.addEventListener('change', function () {
                if (serviceDateInput.value && serviceDateInput.value < todayStr) {
                    serviceDateInput.value = todayStr;
                }
                serviceDateInput.min = todayStr;
            });

            // ---------------- DATE OF COMPLETION ----------------
            const dateOfCompletionInput = document.getElementById('dateOfCompletionInput');
            function addDaysToDateString(dateStr, days) {
                const d = new Date(dateStr + 'T00:00:00');
                d.setDate(d.getDate() + days);
                return d.toISOString().slice(0, 10);
            }
            function applyDateOfCompletionMin() {
                if (!serviceDateInput.value) return;
                dateOfCompletionInput.min = serviceDateInput.value;
                // Bump the deadline two days past the new service date rather
                // than same-day, matching the Create page's default - a
                // reschedule shouldn't leave the job due (or already overdue)
                // the moment the new service date arrives.
                if (dateOfCompletionInput.value && dateOfCompletionInput.value < serviceDateInput.value) {
                    dateOfCompletionInput.value = addDaysToDateString(serviceDateInput.value, 2);
                }
            }
            serviceDateInput.addEventListener('change', applyDateOfCompletionMin);
            applyDateOfCompletionMin();

            // ---------------- LEADER SELECTION (Pending only) ----------------
            // Moves the "Leader" badge next to whichever assigned technician is
            // currently selected — mirrors the Create page's behavior, just
            // without the ability to add/remove technicians here.
            document.querySelectorAll('.leaderRadio').forEach(function (radio) {
                radio.addEventListener('change', function () {
                    document.querySelectorAll('.leaderTag').forEach(function (tag) {
                        tag.classList.add('d-none');
                    });
                    var nameSpan = document.getElementById('empName-' + radio.value);
                    if (nameSpan) {
                        var tag = nameSpan.querySelector('.leaderTag');
                        if (tag) tag.classList.remove('d-none');
                    }
                });
            });

            // jobTypeSelect/fiberPlanSelect are now hidden inputs backing the
            // custom dropdowns above, so the browser's native "required"
            // blocking (and jQuery Validate, which ignores hidden fields by
            // default) no longer catches an empty one - checked by hand here.
            document.getElementById('ticketForm').addEventListener('submit', function (e) {
                if (!jobTypeSelect.value) {
                    e.preventDefault();
                    alert('Please select a job type.');
                    return;
                }
                if (fiberPlanSelect.hasAttribute('required') && !fiberPlanSelect.value) {
                    e.preventDefault();
                    alert('Please select a fiber plan.');
                }
            });
        })();
    </script>
}
