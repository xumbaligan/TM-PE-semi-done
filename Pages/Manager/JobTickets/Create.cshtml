@page
@model TM_PE.Pages.Manager.JobTickets.CreateModel

@{
    ViewData["Title"] = "Create Job Ticket";
    Layout = "_Layout";

    // Purely numeric plan names (the original hardcoded prices, e.g. "999") are
    // shown the way they always were ("₱999 / month"); free-form plans a manager
    // types into the "Fiber Plans" modal (e.g. "Fiber 500 Promo") are shown as-is.
    string FiberPlanDisplay(string name) =>
        System.Text.RegularExpressions.Regex.IsMatch(name, @"^\d+$") ? $"₱{name} / month" : name;
}

<div class="mb-3">
    <h1 class="tf-page-title mb-1">Job Ticket Form</h1>
    <p class="tf-page-sub mb-0">
        Fill out the job details, enter the installation location, and assign field technicians.
    </p>
</div>

<form method="post" id="ticketForm">

    <partial name="_RestrictionModal" model="(string?)null" />

    <!-- Read-only meta strip: ticket number + date created + assigned by -->
    <div class="tf-meta-card mb-4">
        <div class="d-flex flex-column flex-md-row">

            <div class="tf-meta-item">
                <div class="tf-meta-icon"><i class="bi bi-tag-fill"></i></div>
                <div class="overflow-hidden">
                    <div class="tf-meta-label">Ticket Number</div>
                    <div class="tf-meta-value">@Model.NextTicketNumber</div>
                </div>
            </div>

            <div class="tf-meta-item">
                <div class="tf-meta-icon"><i class="bi bi-calendar3"></i></div>
                <div class="overflow-hidden">
                    <div class="tf-meta-label">Date Created</div>
                    <div class="tf-meta-value">@Model.JobTicket.DateCreated.ToString("MM/dd/yyyy")</div>
                </div>
            </div>

            <div class="tf-meta-item">
                <div class="tf-meta-icon"><i class="bi bi-person-fill"></i></div>
                <div class="overflow-hidden">
                    <div class="tf-meta-label">Assigned by</div>
                    <div class="tf-meta-value">@Model.CurrentManagerName</div>
                </div>
            </div>

        </div>
    </div>

    @*
        DateCreated is displayed read-only above but still has to post, so it
        keeps its hidden input. The old disabled inputs for ticket number and
        manager name never posted anything - both are resolved server-side.
    *@
    <input type="hidden" asp-for="JobTicket.DateCreated" />

    <!-- Step 1: Job Details -->
    <div class="tf-section mb-4">

        <div class="d-flex align-items-center gap-2 mb-4">
            <div class="tf-step-badge">1</div>
            <div class="tf-section-title">Job Details</div>
        </div>

        <!-- Job Type -->
        <div class="mb-3">
            <label class="tf-label" asp-for="JobTicket.JobType">
                Job Type <span class="tf-required">*</span>
            </label>

            <div class="dropdown">
                <button type="button" class="btn status-dropdown-btn dropdown-toggle w-100" id="jobTypeDropdownBtn"
                        data-bs-toggle="dropdown" aria-expanded="false">
                    Select job type
                </button>
                <ul class="dropdown-menu status-dropdown-menu w-100" aria-labelledby="jobTypeDropdownBtn">
                    <li><a class="dropdown-item active" href="#" data-value="">Select job type</a></li>
                    @foreach (var type in Model.JobTypeOptions)
                    {
                        <li><a class="dropdown-item" href="#" data-value="@type">@type</a></li>
                    }
                </ul>
            </div>
            <input type="hidden" asp-for="JobTicket.JobType" id="jobTypeSelect" />

            <span asp-validation-for="JobTicket.JobType" class="text-danger small"></span>
        </div>

        <!-- Client Info (auto-cleared/hidden when Job Type = Maintenance) -->
        <div class="row g-3 mb-3" id="clientInfoGroup">
            <div class="col-md-4">
                <label class="tf-label" asp-for="JobTicket.ClientFullName">
                    Full Name (Client) <span class="tf-required">*</span>
                </label>

                <input asp-for="JobTicket.ClientFullName"
                       id="clientFullNameInput"
                       class="form-control"
                       placeholder="e.g. Juan Dela Cruz"
                       required />

                <span asp-validation-for="JobTicket.ClientFullName" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label class="tf-label" asp-for="JobTicket.PrimaryNumber">
                    Primary Number <span class="tf-required">*</span>
                </label>

                <input asp-for="JobTicket.PrimaryNumber"
                       id="primaryNumberInput"
                       class="form-control"
                       placeholder="09171234567"
                       inputmode="numeric"
                       maxlength="11"
                       required />

                <span asp-validation-for="JobTicket.PrimaryNumber" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label class="tf-label" asp-for="JobTicket.SecondaryNumber">
                    Secondary Number
                </label>

                <input asp-for="JobTicket.SecondaryNumber"
                       id="secondaryNumberInput"
                       class="form-control"
                       placeholder="Optional"
                       inputmode="numeric"
                       maxlength="11" />

                <span asp-validation-for="JobTicket.SecondaryNumber" class="text-danger small"></span>
            </div>
        </div>

        <!-- Fiber Plan (Installation) / Description (Repair, Inspection, Maintenance) + Date -->
        <div class="row g-3 mb-3">
            <div class="col-md-6" id="fiberPlanGroup">
                <label class="tf-label" asp-for="JobTicket.FiberPlan">
                    Fiber Plan <span class="tf-required">*</span>
                </label>

                <div class="d-flex gap-2">
                    <div class="dropdown flex-grow-1">
                        <button type="button" class="btn status-dropdown-btn dropdown-toggle w-100" id="fiberPlanDropdownBtn"
                                data-bs-toggle="dropdown" aria-expanded="false">
                            Select a plan
                        </button>
                        <ul class="dropdown-menu status-dropdown-menu w-100" id="fiberPlanDropdownMenu" aria-labelledby="fiberPlanDropdownBtn">
                            <li><a class="dropdown-item active" href="#" data-value="">Select a plan</a></li>
                            @foreach (var plan in Model.FiberPlanOptions)
                            {
                                <li><a class="dropdown-item" href="#" data-value="@plan.PlanName">@FiberPlanDisplay(plan.PlanName)</a></li>
                            }
                        </ul>
                    </div>
                    <input type="hidden" asp-for="JobTicket.FiberPlan" id="fiberPlanSelect" />

                    <button type="button" class="tf-btn-add-outline" id="openFiberPlanModalBtn"
                            data-bs-toggle="modal" data-bs-target="#fiberPlanModal">
                        <i class="bi bi-plus-circle-fill"></i> Add Fiber Plan
                    </button>
                </div>

                <span asp-validation-for="JobTicket.FiberPlan" class="text-danger small"></span>
            </div>

            <div class="col-md-6 d-none d-flex flex-column" id="descriptionGroup">
                <label class="tf-label" asp-for="JobTicket.Description">
                    Description <span class="tf-required">*</span>
                </label>

                <textarea asp-for="JobTicket.Description"
                          id="descriptionInput"
                          class="form-control flex-grow-1"
                          rows="4"
                          maxlength="500"
                          placeholder="Describe the job"></textarea>

                <span asp-validation-for="JobTicket.Description" class="text-danger small"></span>
            </div>

            <div class="col-md-6" id="serviceDateGroup">
                <label class="tf-label" id="serviceDateLabel" asp-for="JobTicket.ServiceDate">
                    Date of Installation <span class="tf-required">*</span>
                </label>

                <input asp-for="JobTicket.ServiceDate"
                       type="date"
                       id="serviceDateInput"
                       min="@DateTime.Now.ToString("yyyy-MM-dd")"
                       value="@Model.JobTicket.ServiceDate.ToString("yyyy-MM-dd")"
                       class="form-control"
                       required />

                <span asp-validation-for="JobTicket.ServiceDate" class="text-danger small"></span>

                <!-- Moved here (below Date of Job, next to Description) by JS
                     for job types with no Fiber Plan - see applyJobType() -
                     out of the DOM's original spot marked by #dueDateAnchor below. -->
                <div class="mb-2" id="dueDateWrap" style="max-width:440px;">
                    <label class="tf-label" asp-for="JobTicket.DateOfCompletion">
                        Due Date <span class="tf-required">*</span>
                    </label>

                    <input asp-for="JobTicket.DateOfCompletion"
                           type="date"
                           id="dateOfCompletionInput"
                           min="@DateTime.Now.ToString("yyyy-MM-dd")"
                           value="@(Model.JobTicket.DateOfCompletion?.ToString("yyyy-MM-dd"))"
                           class="form-control"
                           required />

                    <span asp-validation-for="JobTicket.DateOfCompletion" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div id="dueDateAnchor"></div>

        <div class="tf-hint" id="serviceDateHint">
            <i class="bi bi-info-circle"></i>
            <span>
                The deadline for this job to be finished. If this date passes and the job
                still isn't done, it's automatically marked Overdue.
            </span>
        </div>

    </div>

    <!-- Step 2: Job Location -->
    <div class="tf-section mb-4">

        <div class="d-flex align-items-center gap-2 mb-4">
            <div class="tf-step-badge">2</div>
            <div class="tf-section-title">Job Location</div>
        </div>

        <div class="mb-3">
            <label class="tf-label" asp-for="JobTicket.LocationAddress">
                Address <span class="tf-required">*</span>
            </label>
            <input asp-for="JobTicket.LocationAddress"
                   id="locationAddressInput"
                   class="form-control"
                   placeholder="Enter the job site address"
                   required />
            <span asp-validation-for="JobTicket.LocationAddress" class="text-danger small"></span>
        </div>

        <div>
            <label class="tf-label" asp-for="JobTicket.NearestLandmark">Nearest Landmark</label>
            <input asp-for="JobTicket.NearestLandmark"
                   id="nearestLandmarkInput"
                   class="form-control"
                   placeholder="e.g. Near the barangay hall" />
            <span asp-validation-for="JobTicket.NearestLandmark" class="text-danger small"></span>
        </div>

    </div>

    <!-- Step 3: Assign Field Technicians -->
    <div class="tf-section mb-4">

        <div class="d-flex align-items-center gap-2 mb-1">
            <div class="tf-step-badge">3</div>
            <div class="tf-section-title">Assign Field Technicians <span class="tf-required">*</span></div>
        </div>
        <p class="tf-section-sub mb-3">
            Only Field Technicians can be assigned to a job ticket. Assign at least 2, and pick one to be the leader.
        </p>

        <div class="d-flex flex-column flex-sm-row gap-2">
            <div class="dropdown flex-grow-1">
                <button type="button" class="btn status-dropdown-btn dropdown-toggle w-100" id="employeeDropdownBtn"
                        data-bs-toggle="dropdown" aria-expanded="false">
                    Select a field technician
                </button>
                <ul class="dropdown-menu status-dropdown-menu w-100" id="employeeDropdownMenu" aria-labelledby="employeeDropdownBtn">
                    <li><a class="dropdown-item active" href="#" data-value="">Select a field technician</a></li>
                    @foreach (var emp in Model.FieldTechnicianList)
                    {
                        <li><a class="dropdown-item" href="#" data-value="@emp.EmployeeId">@emp.FullName</a></li>
                    }
                </ul>
            </div>
            <input type="hidden" id="employeeSelect" />

            <button type="button" id="addEmployeeBtn" class="tf-btn-add-outline">
                <i class="bi bi-plus-circle-fill"></i> Add Technician
            </button>
        </div>

        <!-- Selected Employees -->
        <div id="selectedEmployees" class="mt-3 d-flex flex-column">
            <span class="tf-empty-msg" id="noEmployeesMsg">No field technicians added yet.</span>
        </div>

    </div>

    <!-- Footer Buttons -->
    <div class="d-flex justify-content-end gap-2">
        <a asp-page="Index" class="tf-btn-cancel">Cancel</a>

        <button type="submit" class="tf-btn-save">Save Job Ticket</button>
    </div>

</form>

@* ===================== Modal: Fiber Plans ===================== *@
<div class="modal fade" id="fiberPlanModal" tabindex="-1" aria-labelledby="fiberPlanModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content vm-content">
            <div class="modal-header vm-header">
                <div class="vm-header-icon"><i class="bi bi-router"></i></div>
                <div class="flex-grow-1 overflow-hidden">
                    <div class="vm-title" id="fiberPlanModalLabel">Fiber Plans</div>
                    <div class="vm-subtitle">Plans available for Installation tickets</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <hr class="vm-header-rule" />
            <div class="modal-body vm-body">
                <div class="vm-card">
                    <div class="d-flex gap-2 mb-2">
                        <input type="text" id="newFiberPlanInput" class="form-control" placeholder="e.g. 1299 or Fiber 500 Promo" maxlength="50" />
                        <button type="button" id="addFiberPlanBtn" class="btn btn-navy text-nowrap">Add</button>
                    </div>
                    <div class="tf-form-hint mb-2">Letters, numbers, spaces, and . , - / ₱ # &amp; ( ) are allowed.</div>
                    <div id="fiberPlanModalError" class="text-danger small mb-2 d-none"></div>

                    <ul class="list-group" id="fiberPlanList">
                        @foreach (var plan in Model.FiberPlanOptions)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center" data-plan-id="@plan.FiberPlanID" data-plan-name="@plan.PlanName">
                                <span>@FiberPlanDisplay(plan.PlanName)</span>
                                <button type="button" class="btn btn-sm btn-link text-danger p-0 fiber-plan-delete-btn" title="Delete">&times;</button>
                            </li>
                        }
                    </ul>
                    <div id="noFiberPlansMsg" class="tf-empty-msg mt-2 @(Model.FiberPlanOptions.Any() ? "d-none" : "")">No fiber plans yet.</div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/address-autocomplete.js"></script>
    <script src="~/js/status-dropdown.js"></script>
    <script>
            (function () {
                // ---------------- ADDRESS AUTOCOMPLETE ----------------
                // Biased toward Cebu/Philippines; users can still search anywhere.
                // initAddressAutocomplete(document.getElementById('locationAddressInput'), { lat: 10.3157, lon: 123.8854 });
                // initAddressAutocomplete(document.getElementById('nearestLandmarkInput'), { lat: 10.3157, lon: 123.8854 });

                // ---------------- JOB TYPE TOGGLE ----------------
                const jobTypeSelect = document.getElementById('jobTypeSelect');
                const fiberPlanGroup = document.getElementById('fiberPlanGroup');
                const fiberPlanSelect = document.getElementById('fiberPlanSelect');
                const descriptionGroup = document.getElementById('descriptionGroup');
                const descriptionInput = document.getElementById('descriptionInput');
                const serviceDateLabel = document.getElementById('serviceDateLabel');
                const serviceDateInput = document.getElementById('serviceDateInput');
                const serviceDateGroup = document.getElementById('serviceDateGroup');
                const dueDateWrap = document.getElementById('dueDateWrap');
                const dueDateAnchor = document.getElementById('dueDateAnchor');

                // A type with no Fiber Plan (Repair/Inspection/Maintenance) moves
                // Due Date up under Date of Job, beside Description, instead of
                // its own full-width row below - the description textarea's
                // flex-grow-1 (see #descriptionGroup) then stretches to match
                // this taller column so the two align. Installation (or no type
                // picked yet) keeps Due Date in its original spot, marked by the
                // empty #dueDateAnchor placeholder left behind there.
                function positionDueDate(hasFiberPlan) {
                    if (hasFiberPlan) {
                        dueDateAnchor.parentNode.insertBefore(dueDateWrap, dueDateAnchor);
                        dueDateWrap.style.maxWidth = '440px';
                        dueDateWrap.classList.remove('mt-3');
                    } else {
                        serviceDateGroup.appendChild(dueDateWrap);
                        dueDateWrap.style.maxWidth = '';
                        dueDateWrap.classList.add('mt-3');
                    }
                }

                // Client Info (Full Name / Primary / Secondary) — only collected for
                // non-Maintenance jobs. Switching to Maintenance clears whatever was typed.
                const clientInfoGroup = document.getElementById('clientInfoGroup');
                const clientFullNameInput = document.getElementById('clientFullNameInput');
                const primaryNumberInput = document.getElementById('primaryNumberInput');
                const secondaryNumberInput = document.getElementById('secondaryNumberInput');

                // Philippine mobile numbers only: digits only, capped at 11
                // (e.g. 09171234567), matching JobTicket.PrimaryNumber/SecondaryNumber.
                function restrictToPhMobile(input) {
                    input.addEventListener('input', function () {
                        input.value = input.value.replace(/\D/g, '').slice(0, 11);
                    });
                }
                restrictToPhMobile(primaryNumberInput);
                restrictToPhMobile(secondaryNumberInput);

                function applyClientInfoVisibility(type) {
                    if (type === 'Maintenance') {
                        clientInfoGroup.classList.add('d-none');
                        clientFullNameInput.value = '';
                        primaryNumberInput.value = '';
                        secondaryNumberInput.value = '';
                        clientFullNameInput.removeAttribute('required');
                        primaryNumberInput.removeAttribute('required');
                    } else {
                        clientInfoGroup.classList.remove('d-none');
                        clientFullNameInput.setAttribute('required', 'required');
                        primaryNumberInput.setAttribute('required', 'required');
                    }
                }

                function applyJobType() {
                    const type = jobTypeSelect.value;
                    positionDueDate(type === 'Installation' || !type);
                    if (type === 'Installation') {
                        fiberPlanGroup.classList.remove('d-none');
                        descriptionGroup.classList.add('d-none');
                        fiberPlanSelect.setAttribute('required', 'required');
                        descriptionInput.removeAttribute('required');
                        serviceDateLabel.innerHTML = 'Date of Installation <span class="text-danger">*</span>';
                    } else if (type === 'Repair') {
                        fiberPlanGroup.classList.add('d-none');
                        descriptionGroup.classList.remove('d-none');
                        fiberPlanSelect.removeAttribute('required');
                        descriptionInput.setAttribute('required', 'required');
                        serviceDateLabel.innerHTML = 'Date of Repair <span class="text-danger">*</span>';
                    } else if (type === 'Inspection') {
                        fiberPlanGroup.classList.add('d-none');
                        descriptionGroup.classList.remove('d-none');
                        fiberPlanSelect.removeAttribute('required');
                        descriptionInput.setAttribute('required', 'required');
                        serviceDateLabel.innerHTML = 'Date of Inspection <span class="text-danger">*</span>';
                    } else if (type === 'Maintenance') {
                        fiberPlanGroup.classList.add('d-none');
                        descriptionGroup.classList.remove('d-none');
                        fiberPlanSelect.removeAttribute('required');
                        descriptionInput.setAttribute('required', 'required');
                        serviceDateLabel.innerHTML = 'Date of Maintenance <span class="text-danger">*</span>';
                    } else {
                        fiberPlanGroup.classList.remove('d-none');
                        descriptionGroup.classList.add('d-none');
                        serviceDateLabel.innerHTML = 'Date <span class="text-danger">*</span>';
                    }
                    applyClientInfoVisibility(type);
                }

                wireStatusDropdown('jobTypeDropdownBtn', jobTypeSelect, { onChange: applyJobType });
                applyJobType();

                // ---------------- DATE OF COMPLETION ----------------
                // The completion deadline can't be set before the service date itself.
                const dateOfCompletionInput = document.getElementById('dateOfCompletionInput');
                function applyDateOfCompletionMin() {
                    if (!serviceDateInput.value) return;
                    dateOfCompletionInput.min = serviceDateInput.value;
                    if (dateOfCompletionInput.value && dateOfCompletionInput.value < serviceDateInput.value) {
                        dateOfCompletionInput.value = serviceDateInput.value;
                    }
                }
                serviceDateInput.addEventListener('change', applyDateOfCompletionMin);
                applyDateOfCompletionMin();

                // ---------------- ASSIGNEES + LEADER ----------------
                const employeeSelect = document.getElementById('employeeSelect');
                const addEmployeeBtn = document.getElementById('addEmployeeBtn');
                const selectedEmployeesDiv = document.getElementById('selectedEmployees');
                const noEmployeesMsg = document.getElementById('noEmployeesMsg');

                // id -> name, preserves insertion order
                const addedEmployees = new Map();
                let leaderId = null;

                // Assignees the manager had already added before a validation error
                // reloaded the page (e.g. a bad phone number, missing description,
                // etc). Without this, the list below would start empty again and the
                // manager would have to re-pick every technician from scratch.
                const preSelectedEmployees = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                                                                                            Model.SelectedEmployees.Select(e => new { id = e.EmployeeId.ToString(), name = e.FullName })));
    const preSelectedLeaderId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                                                                Model.LeaderEmployeeId > 0 ? Model.LeaderEmployeeId.ToString() : null));

    // Once a technician is selected, their entry disappears from the
    // dropdown menu (rather than being reordered on removal like the old
    // <select> did - each entry just stays in its original alphabetical
    // spot in the DOM and is toggled hidden/visible).
    const employeeDropdownController = wireStatusDropdown('employeeDropdownBtn', employeeSelect);
    const employeeItems = Array.from(document.querySelectorAll('#employeeDropdownMenu .dropdown-item[data-value]'))
        .filter(i => i.dataset.value !== '');
    const employeeNameById = new Map(employeeItems.map(i => [i.dataset.value, i.textContent.trim()]));

                function hideOptionFromDropdown(id) {
                    const item = employeeItems.find(i => i.dataset.value === id);
                    if (item) item.closest('li').classList.add('d-none');
                }

                function restoreOptionToDropdown(id) {
                    const item = employeeItems.find(i => i.dataset.value === id);
                    if (item) item.closest('li').classList.remove('d-none');
                }

                function renderEmployeeRow(id, name) {
                    const row = document.createElement('div');
                    row.className = 'tf-chip';
                    row.dataset.employeeId = id;
                    row.innerHTML = `
                        <input class="form-check-input flex-shrink-0 mt-0" type="radio" name="leaderRadio"
                               id="leaderRadio-${id}" title="Set as leader" ${leaderId === id ? 'checked' : ''}>
                        <span class="flex-grow-1" id="empName-${id}"></span>
                        <button type="button" class="tf-chip-remove" title="Remove" aria-label="Remove technician">&times;</button>
                        <input type="hidden" name="SelectedEmployeeIds" value="${id}" />
                    `;

                    row.querySelector('input[type=radio]').addEventListener('change', function () {
                        leaderId = id;
                        document.getElementById('leaderEmployeeIdInput').value = id;
                        refreshLeaderTags();
                    });

                    row.querySelector('.tf-chip-remove').addEventListener('click', function () {
                        addedEmployees.delete(id);
                        row.remove();
                        restoreOptionToDropdown(id);
                        if (leaderId === id) {
                            leaderId = null;
                            document.getElementById('leaderEmployeeIdInput').value = '';
                            // Auto-promote the next remaining technician to leader, if any
                            const remaining = [...addedEmployees.keys()];
                            if (remaining.length > 0) {
                                leaderId = remaining[0];
                                document.getElementById('leaderEmployeeIdInput').value = leaderId;
                                const nextRadio = document.getElementById(`leaderRadio-${leaderId}`);
                                if (nextRadio) nextRadio.checked = true;
                            }
                        }
                        refreshLeaderTags();
                        if (addedEmployees.size === 0) {
                            noEmployeesMsg.style.display = '';
                        }
                    });

                    selectedEmployeesDiv.appendChild(row);
                    refreshLeaderTags();
                }

                // Only the currently Selected/assigned leader gets the "Leader" tag
                // next to their name — everyone else just shows their plain name.
                function refreshLeaderTags() {
                    addedEmployees.forEach(function (name, id) {
                        const nameSpan = document.getElementById(`empName-${id}`);
                        if (!nameSpan) return;
                        nameSpan.innerHTML = (id === leaderId)
                            ? `${name} <span class="tf-leader-badge ms-2">Leader</span>`
                            : name;
                    });
                }

                // Hidden input carrying the chosen leader's EmployeeId
                const leaderHidden = document.createElement('input');
                leaderHidden.type = 'hidden';
                leaderHidden.id = 'leaderEmployeeIdInput';
                leaderHidden.name = 'LeaderEmployeeId';
                leaderHidden.value = '';
                document.getElementById('ticketForm').appendChild(leaderHidden);

                // Restore any assignees (and the chosen leader) that survived a
                // validation error on the server, so they don't have to be re-added.
                preSelectedEmployees.forEach(function (emp) {
                    if (addedEmployees.has(emp.id)) return;
                    addedEmployees.set(emp.id, emp.name);
                    noEmployeesMsg.style.display = 'none';
                    renderEmployeeRow(emp.id, emp.name);
                    hideOptionFromDropdown(emp.id);
                });

                if (addedEmployees.size > 0) {
                    if (preSelectedLeaderId && addedEmployees.has(preSelectedLeaderId)) {
                        leaderId = preSelectedLeaderId;
                    } else {
                        leaderId = [...addedEmployees.keys()][0];
                    }
                    leaderHidden.value = leaderId;
                    const leaderRadio = document.getElementById(`leaderRadio-${leaderId}`);
                    if (leaderRadio) leaderRadio.checked = true;
                    refreshLeaderTags();
                }

                addEmployeeBtn.addEventListener('click', function () {
                    const id = employeeSelect.value;
                    const name = employeeNameById.get(id);

                    if (!id) return;
                    if (addedEmployees.has(id)) return;

                    addedEmployees.set(id, name);
                    noEmployeesMsg.style.display = 'none';

                    renderEmployeeRow(id, name);
                    hideOptionFromDropdown(id);

                    // First technician added is auto-selected as leader
                    if (addedEmployees.size === 1) {
                        leaderId = id;
                        leaderHidden.value = id;
                        document.getElementById(`leaderRadio-${id}`).checked = true;
                        refreshLeaderTags();
                    }

                    employeeDropdownController.selectByValue('', false);
                });

                // ---------------- FIBER PLANS MODAL ----------------
                (function () {
                    const planSelect = document.getElementById('fiberPlanSelect');
                    const fiberPlanController = wireStatusDropdown('fiberPlanDropdownBtn', planSelect);
                    const planList = document.getElementById('fiberPlanList');
                    const noPlansMsg = document.getElementById('noFiberPlansMsg');
                    const newPlanInput = document.getElementById('newFiberPlanInput');
                    const addPlanBtn = document.getElementById('addFiberPlanBtn');
                    const errorBox = document.getElementById('fiberPlanModalError');

                    // Same restriction enforced server-side (Model.FiberPlanRules.AllowedPattern):
                    // letters, numbers, spaces, and a small set of punctuation.
                    const allowedPattern = /^[A-Za-z0-9À-ÖØ-öø-ÿ.,\-\/₱#&()\s]+$/;

                    const token = document.querySelector('#ticketForm input[name="__RequestVerificationToken"]')?.value || '';

                    // Purely numeric plans keep the original "₱999 / month" display;
                    // free-form plans are shown as typed.
                    function formatPlan(name) {
                        return /^\d+$/.test(name) ? `₱${name} / month` : name;
                    }

                    function showError(msg) {
                        errorBox.textContent = msg;
                        errorBox.classList.remove('d-none');
                    }

                    function clearError() {
                        errorBox.classList.add('d-none');
                        errorBox.textContent = '';
                    }

                    function addRow(id, name) {
                        const li = document.createElement('li');
                        li.className = 'list-group-item d-flex justify-content-between align-items-center';
                        li.dataset.planId = id;
                        li.dataset.planName = name;
                        li.innerHTML = `<span></span><button type="button" class="btn btn-sm btn-link text-danger p-0 fiber-plan-delete-btn" title="Delete">&times;</button>`;
                        li.querySelector('span').textContent = formatPlan(name);
                        planList.appendChild(li);
                        noPlansMsg.classList.add('d-none');
                    }

                    addPlanBtn.addEventListener('click', async function () {
                        clearError();
                        const name = newPlanInput.value.trim();

                        if (!name) {
                            showError('Please enter a fiber plan.');
                            return;
                        }
                        if (name.length > 50) {
                            showError('Fiber plan name is too long (max 50 characters).');
                            return;
                        }
                        if (!allowedPattern.test(name)) {
                            showError('Only letters, numbers, spaces, and . , - / ₱ # & ( ) are allowed.');
                            return;
                        }

                        addPlanBtn.disabled = true;
                        try {
                            const body = new URLSearchParams();
                            body.set('planName', name);
                            body.set('__RequestVerificationToken', token);

                            const res = await fetch('?handler=AddFiberPlan', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                                body: body.toString()
                            });
                            const data = await res.json();

                            if (!res.ok || !data.success) {
                                showError(data.message || 'Could not add that fiber plan.');
                                return;
                            }

                            addRow(data.id, data.name);
                            fiberPlanController.addItem(data.name, formatPlan(data.name));
                            newPlanInput.value = '';
                        } catch (err) {
                            showError('Something went wrong. Please try again.');
                        } finally {
                            addPlanBtn.disabled = false;
                        }
                    });

                    newPlanInput.addEventListener('keydown', function (e) {
                        if (e.key === 'Enter') {
                            e.preventDefault();
                            addPlanBtn.click();
                        }
                    });

                    planList.addEventListener('click', async function (e) {
                        const btn = e.target.closest('.fiber-plan-delete-btn');
                        if (!btn) return;

                        clearError();
                        const li = btn.closest('li');
                        const id = li.dataset.planId;
                        const name = li.dataset.planName;

                        btn.disabled = true;
                        try {
                            const body = new URLSearchParams();
                            body.set('id', id);
                            body.set('__RequestVerificationToken', token);

                            const res = await fetch('?handler=DeleteFiberPlan', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                                body: body.toString()
                            });
                            const data = await res.json();

                            if (!res.ok || !data.success) {
                                showError(data.message || 'Could not delete that fiber plan.');
                                btn.disabled = false;
                                return;
                            }

                            li.remove();
                            if (!planList.children.length) {
                                noPlansMsg.classList.remove('d-none');
                            }

                            // Clears the selection first if the plan being removed was
                            // selected in the main form, so a deleted plan can't be submitted.
                            fiberPlanController.removeItem(name);
                        } catch (err) {
                            showError('Something went wrong. Please try again.');
                            btn.disabled = false;
                        }
                    });
                })();

                document.getElementById('ticketForm').addEventListener('submit', function (e) {
                    // jobTypeSelect/fiberPlanSelect are now hidden inputs backing the
                    // custom dropdowns above, so the browser's native "required"
                    // blocking (and jQuery Validate, which ignores hidden fields by
                    // default) no longer catches an empty one - checked by hand here
                    // instead, same as the technician/leader checks below.
                    if (!jobTypeSelect.value) {
                        e.preventDefault();
                        alert('Please select a job type.');
                        return;
                    }
                    if (fiberPlanSelect.hasAttribute('required') && !fiberPlanSelect.value) {
                        e.preventDefault();
                        alert('Please select a fiber plan.');
                        return;
                    }
                    if (addedEmployees.size < 2) {
                        e.preventDefault();
                        alert('Please assign at least 2 field technicians.');
                        return;
                    }
                    if (!leaderHidden.value) {
                        e.preventDefault();
                        alert('Please choose a leader among the assigned field technicians.');
                    }
                });
            })();
    </script>
}
