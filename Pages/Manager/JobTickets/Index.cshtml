@page
@model TM_PE.Pages.Manager.JobTickets.IndexModel
@{
    ViewData["Title"] = "Job Tickets";
    Layout = "_Layout";
}
<div class="mb-3">
    <h2 class="mb-1"><i class="bi bi-tools"></i> Job Ticket Management</h2>
    <p class="text-muted mb-0">Field service tickets and technician assignments.</p>
</div>
<hr class="page-divider" />

<form method="get" class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <div class="input-group shadow-sm flex-grow-1" style="max-width:480px;">
        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
        <input class="form-control border-start-0 ps-0" name="search" id="liveSearch"
               value="@Model.Search" placeholder="Search by leader, job type, ticket #, or client..." />
    </div>
    <select class="form-select" name="status" id="liveStatus" style="max-width:220px;">
        <option value="">All Statuses</option>
        <option value="Pending" selected="@(Model.StatusFilter == "Pending")">Pending</option>
        <option value="In Progress" selected="@(Model.StatusFilter == "In Progress")">In Progress</option>
        <option value="Reschedule Request" selected="@(Model.StatusFilter == "Reschedule Request")">Reschedule Request</option>
        <option value="Completed" selected="@(Model.StatusFilter == "Completed")">Completed</option>
        <option value="Completed Late" selected="@(Model.StatusFilter == "Completed Late")">Completed Late</option>
        <option value="Cancelled" selected="@(Model.StatusFilter == "Cancelled")">Cancelled</option>
        <option value="Rescheduled" selected="@(Model.StatusFilter == "Rescheduled")">Rescheduled</option>
        <option value="Overdue" selected="@(Model.StatusFilter == "Overdue")">Overdue</option>
    </select>
    <a asp-page="Create" class="btn btn-navy ms-auto">
        <i class="bi bi-plus-lg"></i> Create New
    </a>
</form>

<div class="table-responsive wlm-card">
    <table class="table align-middle table-hover wlm-table mb-0">
        <thead>
            <tr>
                <th>Task Number</th>
                <th>Job Type</th>
                <th>Leader</th>
                <th>Status</th>
                <th>Due Date</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.JobTicket.Any())
            {
                <tr id="emptyRow">
                    <td colspan="7" class="text-center text-muted py-4">No job tickets yet.</td>
                </tr>
            }
            else
            {
                <tr id="emptyRow" style="display:none;">
                    <td colspan="7" class="text-center text-muted py-4">No job tickets found</td>
                </tr>
            }
            @foreach (var item in Model.JobTicket)
            {
                var leader = item.Assignments?.FirstOrDefault(a => a.IsLeader)?.Employee;
                <tr data-leader="@(leader?.FullName.ToLower() ?? "")"
                    data-jobtype="@item.JobType.ToLower()"
                    data-ticketid="@item.TicketNumber.ToLower()"
                    data-status="@item.DisplayStatus.ToLower()">
                    <td class="text-muted">@item.TicketNumber</td>
                    <td class="fw-semibold">@item.JobType</td>
                    <td>
                        @if (leader != null)
                        {
                            <div class="d-flex align-items-center gap-2">
                                <div class="wlm-avatar">
                                    @(string.Join("", leader.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(n => char.ToUpper(n[0]))))
                                </div>
                                <span>@leader.FullName</span>
                            </div>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td>
                        @{
                            var badgeClass = item.DisplayStatus switch
                            {
                                "Completed" => "bg-success-subtle text-success",
                                "Completed Late" => "bg-warning-subtle text-warning-emphasis",
                                "In Progress" => "bg-info-subtle text-info",
                                "Cancelled" => "bg-danger-subtle text-danger",
                                "Rescheduled" => "bg-warning-subtle text-warning-emphasis",
                                "Overdue" => "bg-danger-subtle text-danger-emphasis",
                                _ => "bg-secondary-subtle text-secondary"
                            };
                        }
                        <span class="status-badge @badgeClass">
                            @item.DisplayStatus
                        </span>
                    </td>
                    <td class="text-muted">@item.ServiceDate.ToString("M/d/yyyy")</td>
                    <td class="text-end">
                        <button type="button" class="btn btn-sm btn-outline-navy" title="View"
                                data-bs-toggle="modal" data-bs-target="#viewModal-@item.JobTicketID">
                            <i class="bi bi-eye"></i>
                        </button>
                        @if (!item.IsLockedFromEditing)
                        {
                            <a asp-page="./Edit" asp-route-id="@item.JobTicketID"
                               class="btn btn-sm btn-outline-navy" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@* ===================== VIEW MODALS ===================== *@
@foreach (var item in Model.JobTicket)
{
    var modalBadgeClass = item.DisplayStatus switch
    {
        "Approved" => "vm-status-info",
        "Completed" => "vm-status-success",
        "Completed Late" => "vm-status-warning",
        "In Progress" => "vm-status-info",
        "Cancelled" => "vm-status-danger",
        "Rescheduled" => "vm-status-warning",
        "Overdue" => "vm-status-danger",
        _ => "vm-status-pending"
    };

    var jobTypeIcon = item.JobType switch
    {
        "Installation" => "bi-hdd-network",
        "Repair" => "bi-wrench-adjustable",
        "Inspection" => "bi-tools",
        "Maintenance" => "bi-gear-wide-connected",
        _ => "bi-tools"
    };

    <div class="modal fade" id="viewModal-@item.JobTicketID" tabindex="-1"
         aria-labelledby="viewModalLabel-@item.JobTicketID" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable modal-dialog-centered">
            <div class="modal-content vm-content">

                <div class="modal-header vm-header">
                    <div class="vm-header-icon"><i class="bi @jobTypeIcon"></i></div>
                    <div class="flex-grow-1 overflow-hidden">
                        <div class="vm-title" id="viewModalLabel-@item.JobTicketID">@item.JobType</div>
                        <div class="vm-subtitle">@item.TicketNumber</div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <hr class="vm-header-rule" />

                <div class="modal-body vm-body">

                    @*
                        Three even columns per row, so the second row sits on the
                        same vertical rules as the first instead of leaving two
                        orphaned cells - matched across the details pages too.
                    *@
                    <div class="vm-card mb-3">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="vm-label">Status</div>
                                <span class="vm-status @modalBadgeClass">@item.DisplayStatus</span>
                            </div>
                            <div class="col-md-4 vm-col-divider">
                                <div class="vm-label">@item.ServiceDateLabel</div>
                                <div class="vm-value">
                                    <i class="bi bi-calendar-event"></i>
                                    @item.ServiceDate.ToString("M/d/yyyy")
                                </div>
                            </div>
                            <div class="col-md-4 vm-col-divider">
                                <div class="vm-label">Assigned By</div>
                                <div class="vm-value">
                                    <i class="bi bi-person-circle"></i>
                                    @(item.AssignedByEmployee?.FullName ?? "—")
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="vm-label">Date Created</div>
                                <div class="vm-value">
                                    <i class="bi bi-calendar3"></i>
                                    @item.DateCreated.ToString("M/d/yyyy")
                                </div>
                            </div>
                            <div class="col-md-4 vm-col-divider">
                                <div class="vm-label">Due Date</div>
                                <div class="vm-value">
                                    <i class="bi bi-calendar-week"></i>
                                    @(item.DateOfCompletion?.ToString("M/d/yyyy") ?? "—")
                                </div>
                            </div>
                            <div class="col-md-4 vm-col-divider">
                                <div class="vm-label">Date Completed</div>
                                <div class="vm-value">
                                    <i class="bi bi-calendar-check"></i>
                                    @(item.DateCompleted?.ToString("M/d/yyyy") ?? "—/—/—")
                                </div>
                            </div>
                        </div>
                    </div>

                    @*
                        Maintenance tickets carry no client details, so the Client
                        Information card is skipped. When that happens, Location and
                        Description sit side by side across the full width instead of
                        stacking in the right half - otherwise they'd hang off the
                        right edge with an empty column beside them, out of line with
                        the date strip above.
                    *@
                    @{
                        var hasClientInfo = item.JobType != TM_PE.Model.JobTypes.Maintenance;
                    }

                    <div class="row g-3 mb-3">

                        @if (hasClientInfo)
                        {
                            <div class="col-lg-6">
                                <div class="vm-card">
                                    <div class="vm-card-title">Client Information</div>

                                    <div class="d-flex align-items-center gap-3 mb-3">
                                        <div class="vm-icon-tile"><i class="bi bi-person-fill"></i></div>
                                        <div class="overflow-hidden">
                                            <div class="vm-label">Client</div>
                                            <div class="vm-value">@item.ClientFullName</div>
                                        </div>
                                    </div>

                                    <div class="row g-3">
                                        <div class="col-sm-6">
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="vm-icon-tile"><i class="bi bi-telephone-fill"></i></div>
                                                <div class="overflow-hidden">
                                                    <div class="vm-label">Primary Number</div>
                                                    <div class="vm-value">@item.PrimaryNumber</div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-6 vm-col-divider">
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="vm-icon-tile"><i class="bi bi-telephone"></i></div>
                                                <div class="overflow-hidden">
                                                    <div class="vm-label">Secondary Number</div>
                                                    <div class="vm-value">@(string.IsNullOrWhiteSpace(item.SecondaryNumber) ? "—" : item.SecondaryNumber)</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="col-lg-6 @(hasClientInfo ? "d-flex flex-column gap-3" : "")">

                            <div class="vm-card">
                                <div class="vm-card-title">Location</div>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="vm-icon-tile"><i class="bi bi-geo-alt-fill"></i></div>
                                    <div class="overflow-hidden">
                                        <div class="vm-label">Address</div>
                                        <div class="vm-value">@item.LocationAddress</div>
                                    </div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(item.NearestLandmark))
                                {
                                    <div class="d-flex align-items-center gap-3 mt-3">
                                        <div class="vm-icon-tile"><i class="bi bi-signpost-fill"></i></div>
                                        <div class="overflow-hidden">
                                            <div class="vm-label">Nearest Landmark</div>
                                            <div class="vm-value">@item.NearestLandmark</div>
                                        </div>
                                    </div>
                                }
                            </div>

                            @if (hasClientInfo)
                            {
                                @if (item.JobType == "Installation")
                                {
                                    <div class="vm-card">
                                        <div class="vm-card-title">Fiber Plan</div>
                                        <div class="vm-value">₱@item.FiberPlan</div>
                                    </div>
                                }
                                else
                                {
                                    <div class="vm-card">
                                        <div class="vm-card-title">Description</div>
                                        <div class="vm-text">@item.Description</div>
                                    </div>
                                }
                            }

                        </div>

                        @if (!hasClientInfo)
                        {
                            <div class="col-lg-6">
                                <div class="vm-card">
                                    <div class="vm-card-title">Description</div>
                                    <div class="vm-text">@item.Description</div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="vm-card mb-3">
                        <div class="vm-card-label mb-2">Assigned Field Technicians</div>
                        @if (item.Assignments != null && item.Assignments.Any(a => a.Employee != null))
                        {
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var a in item.Assignments.Where(a => a.Employee != null))
                                {
                                    <span class="vm-pill">
                                        @a.Employee!.FullName
                                        @if (a.IsLeader)
                                        {
                                            <span class="tf-leader-badge">Leader</span>
                                        }
                                    </span>
                                }
                            </div>
                        }
                        else
                        {
                            <span class="tf-empty-msg">No assignees</span>
                        }
                    </div>

                    @if (item.Status == "Reschedule Request" || item.Status == "Rescheduled")
                    {
                        @if (!string.IsNullOrWhiteSpace(item.Remarks))
                        {
                            <div class="vm-card mb-3">
                                <div class="vm-card-label mb-2">Remarks (from Field Technician Leader)</div>
                                <div class="vm-text">@item.Remarks</div>
                            </div>
                        }

                        @if (item.RescheduleHistory != null && item.RescheduleHistory.Any())
                        {
                            <div class="vm-card">
                                <div class="vm-card-label mb-2">
                                    <i class="bi bi-calendar-event"></i> Reschedule History
                                </div>
                                @foreach (var h in item.RescheduleHistory)
                                {
                                    <div class="vm-pill d-flex flex-column align-items-start mb-2 w-100">
                                        <div>
                                            @h.OldServiceDate.ToString("M/d/yyyy")
                                            <i class="bi bi-arrow-right mx-1"></i>
                                            @h.NewServiceDate.ToString("M/d/yyyy")
                                            <span class="fw-normal ms-2">(@h.DateChanged.ToString("M/d/yyyy h:mm tt"))</span>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(h.Reason))
                                        {
                                            <div class="vm-label mt-2 mb-0">Reason</div>
                                            <div class="fw-normal">@h.Reason</div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }

                </div>

                <div class="modal-footer vm-footer">
                    <button type="button" class="vm-btn-close" data-bs-dismiss="modal">Close</button>
                    <a asp-page="./Details" asp-route-id="@item.JobTicketID" class="vm-btn-primary">
                        Open Full Details
                    </a>
                </div>

            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        const searchInput = document.getElementById('liveSearch');
        const statusSelect = document.getElementById('liveStatus');
        const rows = document.querySelectorAll('tbody tr[data-ticketid]');

        function filterTable() {
            const searchVal = searchInput.value.toLowerCase().trim();
            const statusVal = statusSelect.value.toLowerCase().trim();
            let visibleCount = 0;

            rows.forEach(row => {
                const leader = row.dataset.leader || '';
                const jobType = row.dataset.jobtype || '';
                const ticketId = row.dataset.ticketid || '';
                const client = row.dataset.client || '';
                const status = row.dataset.status || '';

                const matchesSearch = leader.includes(searchVal) || jobType.includes(searchVal)
                    || ticketId.includes(searchVal) || client.includes(searchVal);
                const matchesStatus = statusVal === '' || status === statusVal;

                if (matchesSearch && matchesStatus) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            const emptyRow = document.getElementById('emptyRow');
            if (emptyRow) {
                emptyRow.style.display = visibleCount === 0 ? '' : 'none';
            }
        }

        searchInput.addEventListener('input', filterTable);
        statusSelect.addEventListener('change', filterTable);

        // Apply immediately on load too, so a link that arrives with
        // ?status=... (e.g. from the Dashboard) actually filters the table
        // instead of only pre-selecting the dropdown.
        filterTable();
    </script>
}
