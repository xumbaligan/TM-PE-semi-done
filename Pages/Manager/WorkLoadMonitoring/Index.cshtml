@page
@model TM_PE.Pages.Manager.WorkLoadMonitoring.IndexModel
@{
    ViewData["Title"] = "Workload Monitoring";
    Layout = "_Layout";
}

<style>
    /* Employee Workload Summary tables: fixed, equal height with their own
       vertical scrollbar so a long employee list scrolls in place instead of
       expanding the table/card. */
    .wlm-summary-scroll {
        max-height: 360px;
        overflow-y: auto;
    }

    .wlm-summary-scroll thead th {
        position: sticky;
        top: 0;
        background-color: var(--bs-body-bg, #fff);
        z-index: 1;
    }
</style>

<div class="mb-3">
    <h2 class="mb-1">Workload Monitoring</h2>
    <p class="text-muted mb-0">Workforce profiles and deployment status.</p>
</div>
<hr class="page-divider" />

<div class="wlm-tabs mb-4" id="wlmTabs" role="tablist">
    <button class="wlm-tab-btn active" id="tickets-tab" data-bs-toggle="tab" data-bs-target="#tickets-pane"
            type="button" role="tab" aria-controls="tickets-pane" aria-selected="true">
        Active Tickets Per Technicians
    </button>
    <button class="wlm-tab-btn" id="tasks-tab" data-bs-toggle="tab" data-bs-target="#tasks-pane"
            type="button" role="tab" aria-controls="tasks-pane" aria-selected="false">
        Active Tasks Per Staff
    </button>
    <button class="wlm-tab-btn" id="summary-tab" data-bs-toggle="tab" data-bs-target="#summary-pane"
            type="button" role="tab" aria-controls="summary-pane" aria-selected="false">
        Employee Workload Summary
    </button>
</div>

<div class="tab-content" id="wlmTabsContent">

    @* ===================== View 1: Active Tickets per Technician ===================== *@
    <div class="tab-pane fade show active" id="tickets-pane" role="tabpanel" aria-labelledby="tickets-tab">
        @if (!Model.TechnicianTickets.Any())
        {
            <p class="text-muted small mb-0">No active Field Technicians to monitor yet.</p>
        }
        else
        {
            <div class="table-responsive wlm-card">
                <table class="table align-middle table-hover wlm-table mb-0">
                    <thead>
                        <tr>
                            <th>Technicians</th>
                            <th>Departments</th>
                            <th class="text-center">Active Tickets</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.TechnicianTickets)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="wlm-avatar">
                                            @(string.Join("", t.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(n => char.ToUpper(n[0]))))
                                        </div>
                                        <strong>@t.FullName</strong>
                                    </div>
                                </td>
                                <td class="fw-bold">@t.DepartmentName</td>
                                <td class="text-center">
                                    @if (t.ActiveTicketCount > 0)
                                    {
                                        <span class="count-badge count-badge-active">@t.ActiveTicketCount</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">0</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-sm btn-outline-navy technician-view-btn"
                                            data-bs-toggle="modal" data-bs-target="#technicianModal"
                                            data-name="@t.FullName"
                                            data-department="@t.DepartmentName"
                                            data-active="@t.ActiveTicketCount"
                                            data-tickets="@System.Text.Json.JsonSerializer.Serialize(t.Tickets)">
                                        <i class="bi bi-eye"></i> View
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @* ===================== View 2: Active Tasks per Office Staff ===================== *@
    <div class="tab-pane fade" id="tasks-pane" role="tabpanel" aria-labelledby="tasks-tab">
        @if (!Model.StaffTasks.Any())
        {
            <p class="text-muted small mb-0">No active Office Staff to monitor yet.</p>
        }
        else
        {
            <div class="table-responsive wlm-card">
                <table class="table align-middle table-hover wlm-table mb-0">
                    <thead>
                        <tr>
                            <th>Staff</th>
                            <th>Departments</th>
                            <th class="text-center">Active Tasks</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.StaffTasks)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="wlm-avatar">
                                            @(string.Join("", s.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(n => char.ToUpper(n[0]))))
                                        </div>
                                        <strong>@s.FullName</strong>
                                    </div>
                                </td>
                                <td class="fw-bold">@s.DepartmentName</td>
                                <td class="text-center">
                                    @if (s.ActiveTaskCount > 0)
                                    {
                                        <span class="count-badge count-badge-active">@s.ActiveTaskCount</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">0</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-sm btn-outline-navy staff-view-btn"
                                            data-bs-toggle="modal" data-bs-target="#staffModal"
                                            data-name="@s.FullName"
                                            data-department="@s.DepartmentName"
                                            data-active="@s.ActiveTaskCount"
                                            data-tasks="@System.Text.Json.JsonSerializer.Serialize(s.Tasks)">
                                        <i class="bi bi-eye"></i> View
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @* ===================== View 3: Employee Workload Summary ===================== *@
    <div class="tab-pane fade" id="summary-pane" role="tabpanel" aria-labelledby="summary-tab">
        <div class="wlm-card p-3 mb-3">
            <h6 class="fw-bold text-uppercase mb-3" style="color:#020236;">Office Staff Workload</h6>
            @if (!Model.Workload.Any())
            {
                <p class="text-muted small mb-0">No active Office Staff to monitor yet.</p>
            }
            else
            {
                <div class="table-responsive wlm-summary-scroll">
                    <table class="table align-middle table-hover wlm-table mb-0">
                        <thead>
                            <tr>
                                <th>Employee</th>
                                <th>Department</th>
                                <th class="text-center">Active Tasks</th>
                                <th class="text-center">Overdue</th>
                                <th class="text-center">Completed</th>
                                <th class="text-center">Pending Activities</th>
                                <th class="text-center">Avg. Score</th>
                                <th style="width:220px;">Workload</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var w in Model.Workload)
                            {
                                var levelClass = w.WorkloadLevel switch
                                {
                                    "Heavy" => "bg-danger-subtle text-danger",
                                    "Moderate" => "bg-warning-subtle text-warning",
                                    _ => "bg-success-subtle text-success"
                                };
                                var barClass = w.WorkloadLevel switch
                                {
                                    "Heavy" => "bg-danger",
                                    "Moderate" => "bg-warning",
                                    _ => "bg-success"
                                };
                                // Cap the visual bar at a reasonable ceiling so one very
                                // heavy workload doesn't flatten everyone else's bar.
                                var barPercent = Math.Min(100, w.WorkloadPoints * 10);

                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="wlm-avatar">
                                                @(string.Join("", w.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(n => char.ToUpper(n[0]))))
                                            </div>
                                            <strong>@w.FullName</strong>
                                        </div>
                                    </td>
                                    <td class="fw-bold">@w.DepartmentName</td>
                                    <td class="text-center">@w.ActiveTasks</td>
                                    <td class="text-center">
                                        @if (w.OverdueTasks > 0)
                                        {
                                            <span class="count-badge count-badge-danger">@w.OverdueTasks</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">0</span>
                                        }
                                    </td>
                                    <td class="text-center">@w.CompletedTasks</td>
                                    <td class="text-center">@w.PendingActivities</td>
                                    <td class="text-center">@w.AvgScore%</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress flex-grow-1" style="height:8px;">
                                                <div class="progress-bar @barClass" style="width:@(barPercent)%"></div>
                                            </div>
                                            <span class="badge rounded-pill @levelClass px-2">@w.WorkloadLevel</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="wlm-card p-3">
            <h6 class="fw-bold text-uppercase mb-3" style="color:#020236;">Field Technician Workload</h6>
            @if (!Model.TechnicianWorkload.Any())
            {
                <p class="text-muted small mb-0">No active Field Technicians to monitor yet.</p>
            }
            else
            {
                <div class="table-responsive wlm-summary-scroll">
                    <table class="table align-middle table-hover wlm-table mb-0">
                        <thead>
                            <tr>
                                <th>Technician</th>
                                <th>Department</th>
                                <th class="text-center">Active Tickets</th>
                                <th class="text-center">Overdue</th>
                                <th class="text-center">Completed</th>
                                <th style="width:220px;">Workload</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var w in Model.TechnicianWorkload)
                            {
                                var levelClass = w.WorkloadLevel switch
                                {
                                    "Heavy" => "bg-danger-subtle text-danger",
                                    "Moderate" => "bg-warning-subtle text-warning",
                                    _ => "bg-success-subtle text-success"
                                };
                                var barClass = w.WorkloadLevel switch
                                {
                                    "Heavy" => "bg-danger",
                                    "Moderate" => "bg-warning",
                                    _ => "bg-success"
                                };
                                var barPercent = Math.Min(100, w.WorkloadPoints * 10);

                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="wlm-avatar">
                                                @(string.Join("", w.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(n => char.ToUpper(n[0]))))
                                            </div>
                                            <strong>@w.FullName</strong>
                                        </div>
                                    </td>
                                    <td class="fw-bold">@w.DepartmentName</td>
                                    <td class="text-center">@w.ActiveTickets</td>
                                    <td class="text-center">
                                        @if (w.OverdueTickets > 0)
                                        {
                                            <span class="count-badge count-badge-danger">@w.OverdueTickets</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">0</span>
                                        }
                                    </td>
                                    <td class="text-center">@w.CompletedTickets</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress flex-grow-1" style="height:8px;">
                                                <div class="progress-bar @barClass" style="width:@(barPercent)%"></div>
                                            </div>
                                            <span class="badge rounded-pill @levelClass px-2">@w.WorkloadLevel</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

</div>

@* ===================== Modal: Technician Ticket Details ===================== *@
<div class="modal fade" id="technicianModal" tabindex="-1" aria-labelledby="technicianModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content vm-content">
            <div class="modal-header vm-header">
                <div class="vm-header-icon"><i class="bi bi-person-badge"></i></div>
                <div class="flex-grow-1 overflow-hidden">
                    <div class="vm-title" id="technicianModalLabel"><span id="technicianModalName"></span></div>
                    <div class="vm-subtitle">Active Job Tickets</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <hr class="vm-header-rule" />
            <div class="modal-body vm-body">
                <div class="vm-card mb-3">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <div class="vm-label">Department</div>
                            <div class="vm-value" id="technicianModalDepartment"></div>
                        </div>
                        <div class="col-sm-6 vm-col-divider">
                            <div class="vm-label">Active Job Tickets</div>
                            <div class="vm-value" id="technicianModalActive"></div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table vm-table align-middle">
                        <thead>
                            <tr>
                                <th>Job ID</th>
                                <th>Type of Job</th>
                                <th>Client</th>
                                <th>Status</th>
                                <th>Date of Job</th>
                                <th>Due Date</th>
                            </tr>
                        </thead>
                        <tbody id="technicianModalTicketList">
                        </tbody>
                    </table>
                </div>
            </div>
            @* <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-arrow-left"></i> Back
                </button>
                <a href="/Manager/JobTickets/Index" class="btn btn-primary">
                    <i class="bi bi-box-arrow-up-right"></i> Open Tickets
                </a>
            </div> *@
        </div>
    </div>
</div>

@* ===================== Modal: Office Staff Task Details ===================== *@
<div class="modal fade" id="staffModal" tabindex="-1" aria-labelledby="staffModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content vm-content">
            <div class="modal-header vm-header">
                <div class="vm-header-icon"><i class="bi bi-person-badge"></i></div>
                <div class="flex-grow-1 overflow-hidden">
                    <div class="vm-title" id="staffModalLabel"><span id="staffModalName"></span></div>
                    <div class="vm-subtitle">Active Tasks</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <hr class="vm-header-rule" />
            <div class="modal-body vm-body">
                <div class="vm-card mb-3">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <div class="vm-label">Department</div>
                            <div class="vm-value" id="staffModalDepartment"></div>
                        </div>
                        <div class="col-sm-6 vm-col-divider">
                            <div class="vm-label">Active Tasks</div>
                            <div class="vm-value" id="staffModalActive"></div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table vm-table align-middle">
                        <thead>
                            <tr>
                                <th>Task ID</th>
                                <th>Task Name</th>
                                <th>Status</th>
                                <th>Date Created</th>
                                <th>Due Date</th>
                            </tr>
                        </thead>
                        <tbody id="staffModalTaskList">
                        </tbody>
                    </table>
                </div>
            </div>
            @* <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-arrow-left"></i> Back
                </button>
                <a href="/Manager/OfficeTask/Index" class="btn btn-primary">
                    <i class="bi bi-box-arrow-up-right"></i> Open Task
                </a>
            </div> *@
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chart.js/dist/chart.umd.min.js"></script>
    <script>
        (function () {
            // ---- Technician "View" modal ----
            const technicianModal = document.getElementById('technicianModal');
            if (technicianModal) {
                technicianModal.addEventListener('show.bs.modal', function (event) {
                    const btn = event.relatedTarget;
                    if (!btn) return;

                    const tickets = JSON.parse(btn.getAttribute('data-tickets') || '[]');

                    document.getElementById('technicianModalName').textContent = btn.getAttribute('data-name') || '';
                    document.getElementById('technicianModalDepartment').textContent = btn.getAttribute('data-department') || '';
                    document.getElementById('technicianModalActive').textContent = btn.getAttribute('data-active') || '0';

                    const list = document.getElementById('technicianModalTicketList');
                    list.innerHTML = '';

                    if (tickets.length === 0) {
                        list.innerHTML = '<tr><td colspan="6"><span class="tf-empty-msg">No active tickets</span></td></tr>';
                        return;
                    }

                    tickets.forEach(t => {
                        const statusClass = t.Status === 'In Progress'
                            ? 'vm-status-info'
                            : 'vm-status-pending';
                        const serviceDate = new Date(t.ServiceDate).toLocaleDateString('en-US', { month: '2-digit', day: '2-digit', year: 'numeric' });
                        const dueDate = t.DueDate
                            ? new Date(t.DueDate).toLocaleDateString('en-US', { month: '2-digit', day: '2-digit', year: 'numeric' })
                            : '—';

                        const row = document.createElement('tr');
                        row.innerHTML = `
                            <td class="fw-semibold">${t.TicketNumber}</td>
                            <td>${t.JobType}</td>
                            <td>${t.JobType === 'Maintenance' ? '—' : t.ClientFullName}</td>
                            <td><span class="vm-status ${statusClass}">${t.Status}</span></td>
                            <td class="text-nowrap">${serviceDate}</td>
                            <td class="text-nowrap">${dueDate}</td>
                        `;
                        list.appendChild(row);
                    });
                });
            }

            // ---- Office Staff "View" modal ----
            const staffModal = document.getElementById('staffModal');
            if (staffModal) {
                staffModal.addEventListener('show.bs.modal', function (event) {
                    const btn = event.relatedTarget;
                    if (!btn) return;

                    const tasks = JSON.parse(btn.getAttribute('data-tasks') || '[]');

                    document.getElementById('staffModalName').textContent = btn.getAttribute('data-name') || '';
                    document.getElementById('staffModalDepartment').textContent = btn.getAttribute('data-department') || '';
                    document.getElementById('staffModalActive').textContent = btn.getAttribute('data-active') || '0';

                    const list = document.getElementById('staffModalTaskList');
                    list.innerHTML = '';

                    if (tasks.length === 0) {
                        list.innerHTML = '<tr><td colspan="5"><span class="tf-empty-msg">No active tasks</span></td></tr>';
                        return;
                    }

                    tasks.forEach(t => {
                        const statusClass = t.Status === 'Overdue'
                            ? 'vm-status-danger'
                            : t.Status === 'In Progress'
                                ? 'vm-status-info'
                                : 'vm-status-pending';
                        const dateCreated = new Date(t.DateCreated).toLocaleDateString('en-US', { month: '2-digit', day: '2-digit', year: 'numeric' });
                        const dueDate = new Date(t.DueDate).toLocaleDateString('en-US', { month: '2-digit', day: '2-digit', year: 'numeric' });

                        const row = document.createElement('tr');
                        row.innerHTML = `
                            <td class="fw-semibold">${t.TaskNumber}</td>
                            <td>${t.TaskName}</td>
                            <td><span class="vm-status ${statusClass}">${t.Status}</span></td>
                            <td class="text-nowrap">${dateCreated}</td>
                            <td class="text-nowrap">${dueDate}</td>
                        `;
                        list.appendChild(row);
                    });
                });
            }
        })();

        (function () {
            const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Workload.Select(w => w.FullName)));
            const points = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Workload.Select(w => w.WorkloadPoints)));
            const levels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Workload.Select(w => w.WorkloadLevel)));

            const colorFor = level => level === 'Heavy' ? '#dc3545'
                : level === 'Moderate' ? '#ffc107'
                : '#198754';

            let chart = null;

            function renderChart() {
                if (chart || !document.getElementById('workloadChart')) return;
                chart = new Chart(document.getElementById('workloadChart'), {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Workload Points',
                            data: points,
                            backgroundColor: levels.map(colorFor),
                            borderRadius: 4,
                            maxBarThickness: 48
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    afterLabel: ctx => 'Level: ' + levels[ctx.dataIndex]
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: { precision: 0 }
                            }
                        }
                    }
                });
            }

            // Chart.js can't size a canvas correctly while its tab pane is hidden,
            // so build it only once the Workload Summary tab is actually shown.
            const summaryTab = document.getElementById('summary-tab');
            if (summaryTab) {
                summaryTab.addEventListener('shown.bs.tab', renderChart);
            }
        })();
    </script>
}
